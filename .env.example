# ---------------------------------------------------------------------------
# Database (Neon Postgres in deployed environments)
# ---------------------------------------------------------------------------
# Runtime queries use the POOLED connection string.
# For Docker/local: postgresql://postgres:floricore_dev_pwd@localhost:5432/floricore?schema=public
DATABASE_URL="postgresql://postgres:floricore_dev_pwd@localhost:5432/floricore?schema=public"

# Prisma CLI (migrate / studio) needs a DIRECT connection — Neon's pooled
# endpoint runs PgBouncer in transaction mode and cannot execute DDL.
# Neon exposes this as DATABASE_URL_UNPOOLED. Leave unset for local Postgres.
DIRECT_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET="super_secret_flori_core_key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="even_more_secret_flori_core_refresh_key"
JWT_REFRESH_EXPIRES_IN="7d"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
MQTT_BROKER_URL=mqtt://localhost:1883

# ---------------------------------------------------------------------------
# CORS — the web app is deployed separately from this API, so every browser
# call is cross-origin. Comma-separated list of exact allowed origins.
# ---------------------------------------------------------------------------
CORS_ORIGINS="http://localhost:3000"
# Set to "true" to also allow https://*.vercel.app (Vercel preview deployments).
CORS_ALLOW_VERCEL_PREVIEWS="false"

# ---------------------------------------------------------------------------
# Object storage — required in production. Without these, generated labels are
# written to local disk, which does not survive a container restart.
# ---------------------------------------------------------------------------
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="floricore-labels"

# ---------------------------------------------------------------------------
# Third-party services
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
MISTRAL_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
SENTRY_DSN=""

# ---------------------------------------------------------------------------
# Web app (apps/web) — must be set in the Vercel project
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_MAPBOX_TOKEN=""
