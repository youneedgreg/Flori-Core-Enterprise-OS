// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Multi-tenancy ──────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     User[]
  auditLogs AuditLog[]

  @@map("tenants")
}

// ── RBAC & Users ──────────────────────────────────────────────────

enum Role {
  gold_admin
  field_supervisor
  qc_lead
  accountant
  hr_manager
  driver
  store_manager
  sales_agent
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(gold_admin)
  
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actorAuditLogs AuditLog[] @relation("ActorLogs")

  @@map("users")
}

// ── Audit Trail ────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  
  actorId    String?
  actor      User?    @relation("ActorLogs", fields: [actorId], references: [id])
  
  action     String   // e.g., "CREATE_ORDER", "UPDATE_CROP_CYCLE"
  entityType String   // e.g., "Order", "CropCycle"
  entityId   String?
  
  beforeState Json?
  afterState  Json?
  
  timestamp  DateTime @default(now())

  @@index([tenantId])
  @@index([timestamp])
  @@map("audit_logs")
}
