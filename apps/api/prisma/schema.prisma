}

model IrrigationLog {
  id              String   @id @default(uuid())
  tenantId        String
  zoneId          String
  date            DateTime
  durationMinutes Int?
  volumeLiters    Float?
  method          String
  fertigationUsed Boolean  @default(false)
  fertilizerType  String?
  npkLevels       String?
  applicationRate Float?
  performedById   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  performedBy     User?    @relation(fields: [performedById], references: [id])
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  zone            Zone     @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@map("irrigation_logs")
}

model ScoutingReport {
  id              String     @id @default(uuid())
  tenantId        String
  zoneId          String
  cropCycleId     String?
  date            DateTime
  pestDiseaseName String?
  severity        String
  observations    String
  actionTaken     String?
  inspectorId     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  cropCycle       CropCycle? @relation(fields: [cropCycleId], references: [id])
  inspector       User       @relation("ScoutingInspector", fields: [inspectorId], references: [id])
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  zone            Zone       @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@map("scouting_reports")
}

model CropPerformanceLog {
  id           String    @id @default(uuid())
  tenantId     String
  cropCycleId  String
  date         DateTime
  growthRate   String?
  healthScore  Int?
  budFormation Boolean   @default(false)
  observations String?
  recordedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cropCycle    CropCycle @relation(fields: [cropCycleId], references: [id])
  recordedBy   User      @relation(fields: [recordedById], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("crop_performance_logs")
}

model PreHarvestQualityLog {
  id           String    @id @default(uuid())
  tenantId     String
  cropCycleId  String
  date         DateTime
  budStage     String?
  budSizeMm    Float?
  stemLengthCm Float?
  stemStrength String?
  colorDev     String?
  inspectorId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cropCycle    CropCycle @relation(fields: [cropCycleId], references: [id])
  inspector    User      @relation(fields: [inspectorId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("pre_harvest_quality_logs")
}

model HarvestRecord {
  id            String    @id @default(uuid())
  tenantId      String
  cropCycleId   String
  date          DateTime
  quantityStems Int
  weightKg      Float?
  rejectedStems Int?
  notes         String?
  supervisorId  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cropCycle     CropCycle @relation(fields: [cropCycleId], references: [id])
  supervisor    User      @relation(fields: [supervisorId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("harvest_records")
}

model TrainingCourse {
  id             String             @id @default(uuid())
  tenantId       String
  name           String
  category       String
  description    String?
  isMandatory    Boolean            @default(false)
  validityMonths Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  records        TrainingRecord[]
  schedules      TrainingSchedule[]

  @@index([tenantId])
  @@map("training_courses")
}

model TrainingRecord {
  id             String         @id @default(uuid())
  tenantId       String
  employeeId     String
  courseId       String
  provider       String?
  completionDate DateTime
  score          Float?
  certificateUrl String?
  expiryDate     DateTime?
  status         String         @default("COMPLETED")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  course         TrainingCourse @relation(fields: [courseId], references: [id])
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant         Tenant         @relation(fields: [tenantId], references: [id])

  @@index([employeeId])
  @@index([tenantId])
  @@map("training_records")
}

model TrainingSchedule {
  id            String         @id @default(uuid())
  tenantId      String
  courseId      String
  scheduledDate DateTime
  department    String?
  trainer       String?
  location      String?
  status        String         @default("SCHEDULED")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  course        TrainingCourse @relation(fields: [courseId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("training_schedules")
}

model PerformanceAppraisal {
  id              String            @id @default(uuid())
  tenantId        String
  employeeId      String
  period          String
  status          String            @default("DRAFT")
  selfScore       Float?
  peerScore       Float?
  supervisorScore Float?
  finalScore      Float?
  kpiScore        Float?
  comments        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  reviews         AppraisalReview[]
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant          Tenant            @relation(fields: [tenantId], references: [id])

  @@index([employeeId])
  @@index([tenantId])
  @@map("performance_appraisals")
}

model AppraisalReview {
  id          String               @id @default(uuid())
  appraisalId String
  reviewerId  String
  type        String
  scores      Json
  comments    String?
  createdAt   DateTime             @default(now())
  appraisal   PerformanceAppraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@map("appraisal_reviews")
}

model EmployeeKPI {
  id          String   @id @default(uuid())
  tenantId    String
  employeeId  String
  name        String
  targetType  String
  targetValue Float
  actualValue Float    @default(0)
  period      String
  updatedAt   DateTime @updatedAt
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([employeeId])
  @@map("employee_kpis")
}

