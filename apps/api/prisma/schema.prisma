generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  status         TenantStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  auditLogs      AuditLog[]
  communications Communication[]
  customers      Customer[]
  leads          Lead[]
  contactLogs    ContactLog[]
  farmProfile    FarmProfile?
  iotDevices     IoTDevice[]
  notifications  Notification[]
  orders         Order[]
  payroll        PayrollRecord[]
  products       Product[]
  roles          Role[]
  telemetry      TelemetryReading[]
  users          User[]
  zones          Zone[]

  settings        Json?            @default("{}")
  unitPreference  UnitSystem       @default(METRIC)
  baseCurrency    String           @default("USD")
  varieties       Variety[]
  cropCycles      CropCycle[]
  cropSchedules   CropSchedule[]
  alerts          Alert[]
  automationRules AutomationRule[]
  labourLogs      LabourLog[]
  sprayLogs       SprayLog[]

  flowerBatches   FlowerBatch[]
  qcLogs          QCLog[]
  flowerInventory FlowerInventory[]
  coldRoomEvents  ColdRoomEvent[]
  packedBoxes     PackedBox[]
  wastageLogs     WastageLog[]

  storeItems            StoreItem[]
  storeStock            StoreStock[]
  storeMovements        StoreMovement[]
  vendors               Vendor[]
  purchaseRequests      PurchaseRequest[]
  purchaseOrders        PurchaseOrder[]
  rfqs                  Rfq[]
  rfqResponses          RfqResponse[]
  vendorPerformanceLogs VendorPerformanceLog[]
  goodsReceivedNotes    GoodsReceivedNote[]
  financialJournals     FinancialJournal[]
  accounts              Account[]
  exchangeRates         ExchangeRate[]
  exportDocuments       ExportDocument[]
  certifications        Certification[]
  taxRates              TaxRate[]

  vehicles       Vehicle[]
  deliveryRoutes DeliveryRoute[]
  deliveryStops  DeliveryStop[]
  invoices       Invoice[]
  vendorInvoices VendorInvoice[]
  costCentres    CostCentre[]
  budgets        Budget[]
  employees      Employee[]
  payrollRuns    PayrollRun[]
  payslips       Payslip[]

  leaveRequests     LeaveRequest[]
  shifts            Shift[]
  shiftAssignments  ShiftAssignment[]

  soilTests             SoilTest[]
  landPrepLogs          LandPrepLog[]
  cropBudgets           CropBudget[]
  plantingRecords       PlantingRecord[]
  irrigationLogs        IrrigationLog[]
  scoutingReports       ScoutingReport[]
  cropPerformanceLogs   CropPerformanceLog[]
  preHarvestQualityLogs PreHarvestQualityLog[]
  harvestRecords        HarvestRecord[]

  @@map("tenants")
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

model Role {
  id          String   @id @default(uuid())
  name        String
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  users       User[]

  @@unique([name, tenantId])
  @@map("roles")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  roleId         String
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  actorAuditLogs AuditLog[]      @relation("ActorLogs")
  notifications  Notification[]  @relation("UserNotifications")
  payrollRecords PayrollRecord[]
  labourLogs     LabourLog[]
  role           Role            @relation(fields: [roleId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  contactLogs    ContactLog[]
  leads          Lead[]

  sprayLogs       SprayLog[]      @relation("SprayApplicator")
  overridenSprays SprayLog[]      @relation("SprayOverrider")
  coldRoomEvents  ColdRoomEvent[]
  deliveryRoutes  DeliveryRoute[]

  landPrepLogs          LandPrepLog[]
  irrigationLogs        IrrigationLog[]
  scoutingReports       ScoutingReport[]       @relation("ScoutingInspector")
  cropPerformanceLogs   CropPerformanceLog[]
  preHarvestQualityLogs PreHarvestQualityLog[]
  harvestRecords        HarvestRecord[]

  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  beforeState Json?
  afterState  Json?
  timestamp   DateTime @default(now())
  actor       User?    @relation("ActorLogs", fields: [actorId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([timestamp])
  @@map("audit_logs")
}

model Communication {
  id         String   @id @default(uuid())
  threadId   String?
  entityType String?
  entityId   String?
  direction  String
  channel    String
  subject    String?
  body       String
  tenantId   String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([threadId])
  @@map("communications")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation("UserNotifications", fields: [userId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("notifications")
}

model FarmProfile {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  name            String
  location        String?
  gpsCoordinates  String?
  certifications  String[]
  logoUrl         String?
  contactEmail    String?
  contactPhone    String?
  defaultCurrency String   @default("KES")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@map("farm_profiles")
}

model Zone {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  type          ZoneType  @default(GREENHOUSE)
  areaSqm       Float?
  plantCount    Float?
  lastWatered   DateTime?
  cropVarieties String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isArchived    Boolean   @default(false)
  layout        Json?

  // Alert Thresholds
  minTemp     Float? @default(0)
  maxTemp     Float? @default(40)
  minHumidity Float? @default(0)
  maxHumidity Float? @default(100)

  devices        IoTDevice[]
  cropCycles     CropCycle[]
  labourLogs     LabourLog[]
  sprayLogs      SprayLog[]
  coldEvents     ColdRoomEvent[]
  storeStock     StoreStock[]
  storeMovements StoreMovement[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id])

  soilTests       SoilTest[]
  landPrepLogs    LandPrepLog[]
  irrigationLogs  IrrigationLog[]
  scoutingReports ScoutingReport[]

  @@map("zones")
}

enum ZoneType {
  GREENHOUSE
  COLD_ROOM
  PACKING_AREA
  OFFICE
  WAREHOUSE
  STORE
}

model IoTDevice {
  id         String             @id @default(uuid())
  tenantId   String
  zoneId     String?
  type       String
  macAddress String             @unique
  mqttTopic  String
  status     String             @default("ACTIVE")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  zone       Zone?              @relation(fields: [zoneId], references: [id])
  readings   TelemetryReading[]

  @@map("iot_devices")
}

enum CustomerType {
  RETAILER
  EXPORTER
  AUCTION_HOUSE
  DIRECT_BUYER
}

enum CustomerSegment {
  LOCAL_RETAIL
  EXPORT
  SPOT_MARKET
}

model Customer {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  email          String?
  phone          String?
  contactPerson  String?
  address        String?
  country        String?
  type           CustomerType    @default(DIRECT_BUYER)
  segment        CustomerSegment @default(LOCAL_RETAIL)
  notes          String?
  commissionRate Float? // For auction houses
  creditLimit    Float? // For retailers/direct buyers
  paymentTerms   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  orders      Order[]
  contactLogs ContactLog[]
  leads       Lead[]

  @@map("customers")
}

model ContactLog {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  userId     String // Sales Rep / Contact person
  type       String // EMAIL, CALL, MEETING, NOTE
  subject    String?
  notes      String
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@map("contact_logs")
}

enum LeadStatus {
  PROSPECT
  NEGOTIATION
  CONTRACT
  ACTIVE
  LOST
}

model Lead {
  id           String     @id @default(uuid())
  tenantId     String
  customerId   String? // Optional link if converted
  name         String // Company / Lead Name
  email        String?
  phone        String?
  status       LeadStatus @default(PROSPECT)
  value        Float? // Deal size
  assignedToId String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer   Customer? @relation(fields: [customerId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  assignedTo User?     @relation(fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@map("leads")
}

model Order {
  id                 String             @id @default(uuid())
  tenantId           String
  type               OrderType          @default(SPOT_ORDER)
  status             OrderStatus        @default(DRAFT)
  orderNumber        String?
  customerId         String
  items              Json
  totalAmount        Float
  currency           String             @default("USD")
  deliveryDate       DateTime?
  shipmentDate       DateTime?
  notes              String?
  isTemplate         Boolean            @default(false)
  parentTemplateId   String?
  templateFrequency  TemplateFrequency?
  nextGenerationDate DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  packedBoxes     PackedBox[]
  template        Order?           @relation("OrderTemplates", fields: [parentTemplateId], references: [id])
  generatedOrders Order[]          @relation("OrderTemplates")
  exportDocuments ExportDocument[]
  deliveryStop    DeliveryStop?
  invoice         Invoice?

  @@index([tenantId])
  @@index([status])
  @@index([isTemplate])
  @@map("orders")
}

model TelemetryReading {
  id         String    @default(uuid())
  tenantId   String
  deviceId   String
  sensorType String    @default("MOISTURE") // MOISTURE, TEMP, EC, PH
  value      Float
  unit       String?
  timestamp  DateTime  @default(now())
  device     IoTDevice @relation(fields: [deviceId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@id([id, timestamp])
  @@index([tenantId])
  @@index([deviceId])
  @@index([timestamp])
  @@map("telemetry_readings")
}

model Alert {
  id        String   @id @default(uuid())
  tenantId  String
  deviceId  String?
  zoneId    String?
  type      String   @default("THRESHOLD_BREACH")
  severity  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  message   String
  status    String   @default("OPEN") // OPEN, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("alerts")
}

model AutomationRule {
  id         String   @id @default(uuid())
  tenantId   String
  zoneId     String?
  name       String
  sensorType String
  operator   String   @default("LT") // LT, GT, EQ
  threshold  Float
  action     String   @default("NOTIFY") // NOTIFY, IRRIGATE_ON
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("automation_rules")
}

model LabourLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String // Employee (System User)
  zoneId      String
  taskType    String // HARVEST, SPRAY, PRUNE, etc.
  hours       Float
  stemsCut    Int? // For productivity metrics
  timestamp   DateTime @default(now())
  gpsLocation Json? // { lat: number, lng: number }

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  zone   Zone   @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
  @@map("labour_logs")
}

model PayrollRecord {
  id          String        @id @default(uuid())
  tenantId    String
  userId      String
  amount      Float
  currency    String        @default("KES")
  status      PayrollStatus @default(PENDING)
  period      String
  paymentDate DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  type        PayrollType @default(FIXED)
  hoursWorked Float?
  hourlyRate  Float?
  baseAmount  Float?

  @@index([tenantId])
  @@index([userId])
  @@map("payroll_records")
}

enum PayrollType {
  FIXED
  HOURLY
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PICKING
  DISPATCHED
  DELIVERED
  INVOICED
}

enum OrderType {
  STANDING_ORDER
  SPOT_ORDER
  EXPORT_CONTRACT
}

enum TemplateFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PayrollStatus {
  PENDING
  PAID
  CANCELLED
}

model Product {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  sku       String   @unique
  stock     Int      @default(0)
  unitPrice Float
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("products")
}

model Variety {
  id                    String            @id @default(uuid())
  tenantId              String
  name                  String
  targetStemLength      Float? // in cm
  targetStemCountPerSqm Float? // units per sqm
  bloomTime             Int? // days from planting
  marketGrade           String?
  defaultCostPerStem    Float?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  tenant                Tenant            @relation(fields: [tenantId], references: [id])
  cropCycles            CropCycle[]
  flowerBatches         FlowerBatch[]
  flowerInventory       FlowerInventory[]
  packedBoxes           PackedBox[]
  wastageLogs           WastageLog[]

  @@map("varieties")
}

model CropCycle {
  id                   String          @id @default(uuid())
  tenantId             String
  varietyId            String
  zoneId               String? // Greenhouse block
  startDate            DateTime
  projectedHarvestDate DateTime?
  actualHarvestDate    DateTime?
  actualHarvestYield   Int? // Stems
  status               CropCycleStatus @default(PLANNED)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  variety       Variety        @relation(fields: [varietyId], references: [id])
  zone          Zone?          @relation(fields: [zoneId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  schedules     CropSchedule[]
  flowerBatches FlowerBatch[]

  cropBudget            CropBudget?
  plantingRecord        PlantingRecord?
  scoutingReports       ScoutingReport[]
  cropPerformanceLogs   CropPerformanceLog[]
  preHarvestQualityLogs PreHarvestQualityLog[]
  harvestRecords        HarvestRecord[]

  @@map("crop_cycles")
}

enum CropCycleStatus {
  PLANNED
  PLANTED
  GROWING
  HARVESTING
  COMPLETED
  CANCELLED
}

model CropSchedule {
  id            String       @id @default(uuid())
  tenantId      String
  cropCycleId   String
  type          ScheduleType
  taskName      String
  scheduledDate DateTime
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@map("crop_schedules")
}

enum ScheduleType {
  SPRAY
  FERTILIZER
  PRUNING
  OTHER
}

model SprayLog {
  id               String   @id @default(uuid())
  tenantId         String
  zoneId           String
  chemicalName     String
  epaRegNo         String
  quantity         Float
  unit             String // L, Kg, ml, g
  phiDays          Int      @default(0)
  applicatorId     String
  appliedAt        DateTime @default(now())
  harvestAllowedAt DateTime
  notes            String?
  overrideReason   String?
  overriddenById   String?

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  zone         Zone   @relation(fields: [zoneId], references: [id])
  applicator   User   @relation("SprayApplicator", fields: [applicatorId], references: [id])
  overriddenBy User?  @relation("SprayOverrider", fields: [overriddenById], references: [id])

  @@index([tenantId])
  @@index([zoneId])
  @@index([appliedAt])
  @@map("spray_logs")
}

model FlowerBatch {
  id             String      @id @default(uuid())
  tenantId       String
  cropCycleId    String
  varietyId      String
  batchNumber    String      @unique // FLR-YYYYMMDD-XXX
  quantityIntake Int
  status         BatchStatus @default(QC_PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  cropCycle      CropCycle       @relation(fields: [cropCycleId], references: [id])
  variety        Variety         @relation(fields: [varietyId], references: [id])
  qcLogs         QCLog[]
  coldRoomEvents ColdRoomEvent[]
  packedBoxes    PackedBox[]

  @@index([tenantId])
  @@index([batchNumber])
  @@map("flower_batches")
}

enum BatchStatus {
  QC_PENDING
  GRADED
  REJECTED
  IN_COLD_STORAGE
  SHIPPED
}

model QCLog {
  id            String   @id @default(uuid())
  tenantId      String
  batchId       String
  inspectorId   String? // User who did the QC
  stemLength    Float
  bloomStage    String
  headDiameter  Float
  defects       Json // Array of strings or object
  assignedGrade QCGrade
  notes         String? // For rejection reasons or extra info
  createdAt     DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  batch  FlowerBatch @relation(fields: [batchId], references: [id])

  @@index([tenantId])
  @@index([batchId])
  @@map("qc_logs")
}

model FlowerInventory {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  varietyId String
  variety   Variety  @relation(fields: [varietyId], references: [id])
  grade     QCGrade
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, varietyId, grade])
  @@index([tenantId])
  @@map("flower_inventory")
}

enum QCGrade {
  A
  B
  C
  REJECT
}

model ColdRoomEvent {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  zoneId    String
  zone      Zone              @relation(fields: [zoneId], references: [id])
  batchId   String
  batch     FlowerBatch       @relation(fields: [batchId], references: [id])
  type      ColdRoomEventType
  quantity  Int
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  timestamp DateTime          @default(now())

  @@index([tenantId])
  @@index([batchId])
  @@index([zoneId])
  @@map("cold_room_events")
}

enum ColdRoomEventType {
  CHECK_IN
  CHECK_OUT
}

model PackedBox {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  batchId       String?
  batch         FlowerBatch? @relation(fields: [batchId], references: [id])
  varietyId     String
  variety       Variety      @relation(fields: [varietyId], references: [id])
  grade         QCGrade
  boxId         String       @unique
  bunchSize     Int
  bunchesPerBox Int
  totalStems    Int
  packDate      DateTime     @default(now())
  destination   String?
  status        BoxStatus    @default(PACKED)
  labelUrl      String?
  orderId       String?
  order         Order?       @relation(fields: [orderId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId])
  @@index([boxId])
  @@map("packed_boxes")
}

enum BoxStatus {
  PACKED
  IN_COLD_STORAGE
  ALLOCATED
  SHIPPED
  DELIVERED
  WASTED
}

model WastageLog {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  varietyId    String
  variety      Variety       @relation(fields: [varietyId], references: [id])
  grade        QCGrade
  quantity     Int // stems wasted
  reason       WastageReason
  costPerStem  Float?
  costImpact   Float? // quantity × costPerStem
  notes        String?
  recordedById String?
  createdAt    DateTime      @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("wastage_logs")
}

enum WastageReason {
  TEMPERATURE_DAMAGE
  DISEASE
  PEST_DAMAGE
  PHYSICAL_DAMAGE
  EXPIRED
  GRADING_REJECT
  OTHER
}

// ─── Stores & Procurement ──────────────────────────────────────────────────────

enum StoreItemCategory {
  FERTILISER
  PESTICIDE
  SEED
  PACKAGING
  PPE
  SPARE_PART
  OTHER
}

enum StoreMovementType {
  GRN // Goods Received Note (stock in)
  ISSUE // Issued to a zone / activity
  RETURN // Returned from zone
  WRITE_OFF // Written off (damaged, expired, lost)
}

model StoreItem {
  id                 String              @id @default(uuid())
  tenantId           String
  name               String
  sku                String
  category           StoreItemCategory   @default(OTHER)
  unit               String              @default("units") // kg, litres, pcs, boxes …
  description        String?
  minStockLevel      Float               @default(0)
  reorderPoint       Float               @default(0)
  maxStockLevel      Float               @default(0) // 0 = not set; engine uses reorderPoint*2 fallback
  unitCost           Float               @default(0)
  lastUnitPrice      Float? // updated on each GRN
  preferredVendorId  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  preferredVendor    Vendor?             @relation(fields: [preferredVendorId], references: [id])
  stock              StoreStock[]
  movements          StoreMovement[]
  purchaseRequests   PurchaseRequest[]
  purchaseOrderItems PurchaseOrderItem[]
  grnItems           GrnItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("store_items")
}

model StoreStock {
  id        String    @id @default(uuid())
  tenantId  String
  itemId    String
  zoneId    String
  quantity  Float     @default(0)
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  item      StoreItem @relation(fields: [itemId], references: [id])
  zone      Zone      @relation(fields: [zoneId], references: [id])

  @@unique([tenantId, itemId, zoneId])
  @@index([tenantId])
  @@map("store_stock")
}

model StoreMovement {
  id          String            @id @default(uuid())
  tenantId    String
  itemId      String
  zoneId      String // Source / owning zone
  type        StoreMovementType
  quantity    Float
  reference   String? // PO number, GRN ref, etc.
  toZoneId    String? // Destination zone for ISSUE movements
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  item        StoreItem         @relation(fields: [itemId], references: [id])
  zone        Zone              @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@index([itemId])
  @@index([createdAt])
  @@map("store_movements")
}

// ─── Vendors ──────────────────────────────────────────────────────────────────

model Vendor {
  id                 String                 @id @default(uuid())
  tenantId           String
  name               String
  contactPerson      String?
  email              String
  phone              String?
  address            String?
  paymentTerms       String? // e.g. "Net 30", "COD"
  taxPin             String?
  bankDetails        Json? // { bankName, accountNo, branch, swiftCode }
  notes              String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  storeItems         StoreItem[] // items where this is the preferred vendor
  purchaseRequests   PurchaseRequest[]
  purchaseOrders     PurchaseOrder[]
  rfqResponses       RfqResponse[]
  performanceLogs    VendorPerformanceLog[]
  goodsReceivedNotes GoodsReceivedNote[]
  vendorInvoices     VendorInvoice[]

  website        String?
  certifications String[] @default([])

  @@index([tenantId])
  @@map("vendors")
}

// ─── Purchase Requests ────────────────────────────────────────────────────────

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED // Converted to a PurchaseOrder
}

model PurchaseRequest {
  id              String                @id @default(uuid())
  tenantId        String
  status          PurchaseRequestStatus @default(PENDING)
  generatedBy     String // "AUTO" or userId of requester
  itemId          String
  vendorId        String?
  currentStock    Float // stock at time of generation
  reorderPoint    Float // snapshot of item's reorderPoint
  suggestedQty    Float // engine-calculated recommended quantity
  approvedQty     Float? // Gold Admin may adjust before approving
  lastUnitPrice   Float? // snapshot of item's lastUnitPrice / unitCost
  estimatedTotal  Float? // suggestedQty × lastUnitPrice
  notes           String? // auto-generated note or admin comment
  rejectionReason String?
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  item            StoreItem             @relation(fields: [itemId], references: [id])
  vendor          Vendor?               @relation(fields: [vendorId], references: [id])
  purchaseOrder   PurchaseOrder?

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_requests")
}

// ─── Purchase Orders ──────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  SENT // Emailed to vendor
  ACKNOWLEDGED // Vendor confirmed receipt
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                 String              @id @default(uuid())
  tenantId           String
  poNumber           String              @unique // e.g. PO-2026-00001
  status             PurchaseOrderStatus @default(DRAFT)
  vendorId           String
  purchaseRequestId  String?             @unique
  expectedDelivery   DateTime?
  totalAmount        Float               @default(0)
  notes              String?
  vendorEmailSentAt  DateTime?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  vendor             Vendor              @relation(fields: [vendorId], references: [id])
  purchaseRequest    PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  items              PurchaseOrderItem[]
  goodsReceivedNotes GoodsReceivedNote[]
  vendorInvoices     VendorInvoice[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

enum GrnStatus {
  PENDING
  RECONCILED
  DISCREPANCY
}

model GoodsReceivedNote {
  id               String    @id @default(uuid())
  tenantId         String
  poId             String
  grnNumber        String    @unique // e.g. GRN-2026-00001
  status           GrnStatus @default(PENDING)
  vendorId         String
  receivedDate     DateTime  @default(now())
  receivedById     String
  notes            String?
  discrepancyNotes String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  items         GrnItem[]
  vendorInvoices VendorInvoice[]

  @@index([tenantId])
  @@index([poId])
  @@map("goods_received_notes")
}

model VendorInvoice {
  id              String    @id @default(uuid())
  tenantId        String
  vendorId        String
  poId            String?   // linked PO
  grnId           String?   // linked GRN (for 3-way match)
  invoiceNumber   String    // Vendor's invoice reference
  status          String    @default("PENDING") // PENDING, APPROVED, SCHEDULED, PAID, REJECTED
  totalAmount     Float
  vatAmount       Float     @default(0)
  whtAmount       Float     @default(0)
  taxRateId       String?
  paidAmount      Float     @default(0)
  currency        String    @default("USD")
  invoiceDate     DateTime
  dueDate         DateTime?
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectionReason String?
  scheduledPayAt  DateTime? // Planned payment date
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  vendor    Vendor             @relation(fields: [vendorId], references: [id])
  po        PurchaseOrder?     @relation(fields: [poId], references: [id])
  grn       GoodsReceivedNote? @relation(fields: [grnId], references: [id])
  taxRate   TaxRate?           @relation(fields: [taxRateId], references: [id])
  payments  VendorPayment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("vendor_invoices")
}

model VendorPayment {
  id              String   @id @default(uuid())
  tenantId        String
  vendorInvoiceId String
  amount          Float
  currency        String   @default("USD")
  method          String   @default("BANK_TRANSFER")
  reference       String?  // bank reference, cheque number
  paidAt          DateTime @default(now())
  exportedAt      DateTime? // when bank file was generated
  notes           String?
  createdAt       DateTime @default(now())

  vendorInvoice VendorInvoice @relation(fields: [vendorInvoiceId], references: [id], onDelete: Cascade)

  @@index([vendorInvoiceId])
  @@map("vendor_payments")
}

model GrnItem {
  id                 String            @id @default(uuid())
  grnId              String
  itemId             String
  quantityReceived   Float
  unitPriceReceived  Float
  totalPriceReceived Float
  poItemId           String? // Link to specific PO line item
  notes              String?
  grn                GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item               StoreItem         @relation(fields: [itemId], references: [id])

  @@index([grnId])
  @@map("grn_items")
}

// ─── Financials (Integrated Ledger) ──────────────────────────────────────────

model FinancialJournal {
  id          String         @id @default(uuid())
  tenantId    String
  reference   String? // e.g. "GRN-0001", "INV-0001"
  description String
  date        DateTime       @default(now())
  userId      String? // User who recorded the entry
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  entries     JournalEntry[]

  @@index([tenantId])
  @@map("financial_journals")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id       String      @id @default(uuid())
  tenantId String
  code     String // e.g. "11000", "21000"
  name     String
  type     AccountType
  currency String?
  isActive Boolean     @default(true)
  tenant   Tenant      @relation(fields: [tenantId], references: [id])

  journalEntries JournalEntry[]

  @@unique([tenantId, code])
  @@map("accounts")
}

model ExchangeRate {
  id            String   @id @default(uuid())
  tenantId      String
  fromCurrency  String
  toCurrency    String
  rate          Float
  effectiveDate DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("exchange_rates")
}

enum TaxType {
  VAT
  WHT
  EXCISE
  OTHER
}

model TaxRate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String   // e.g. "VAT 16%", "WHT 5%"
  rate      Float    // e.g. 16.0
  type      TaxType  @default(VAT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  invoices       Invoice[]
  vendorInvoices VendorInvoice[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tax_rates")
}

model JournalEntry {
  id           String  @id @default(uuid())
  journalId    String
  accountId    String? // Relation to chart of accounts
  accountCode  String // e.g. "11000" (Inventory)
  debit        Float   @default(0)
  credit       Float   @default(0)
  exchangeRate Float?  @default(1.0)
  baseDebit    Float?
  baseCredit   Float?

  journal FinancialJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account Account?         @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@map("journal_entries")
}

model PurchaseOrderItem {
  id         String        @id @default(uuid())
  poId       String
  itemId     String
  quantity   Float
  unitPrice  Float
  totalPrice Float
  notes      String?
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item       StoreItem     @relation(fields: [itemId], references: [id])

  @@index([poId])
  @@map("purchase_order_items")
}

// ─── RFQs & Performance ──────────────────────────────────────────────────────

enum RfqStatus {
  DRAFT
  SENT
  CLOSED
  CANCELLED
}

model Rfq {
  id         String        @id @default(uuid())
  tenantId   String
  status     RfqStatus     @default(DRAFT)
  items      Json // [{ itemId: string, quantity: number, notes: string }]
  notes      String?
  expiryDate DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  responses  RfqResponse[]

  @@index([tenantId])
  @@map("rfqs")
}

enum RfqResponseStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model RfqResponse {
  id           String            @id @default(uuid())
  rfqId        String
  vendorId     String
  tenantId     String
  unitPrice    Float
  totalAmount  Float
  currency     String            @default("USD")
  deliveryDays Int? // Lead time in days
  validUntil   DateTime?
  notes        String?
  status       RfqResponseStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  rfq          Rfq               @relation(fields: [rfqId], references: [id])
  vendor       Vendor            @relation(fields: [vendorId], references: [id])
  tenant       Tenant            @relation(fields: [tenantId], references: [id])

  @@index([rfqId])
  @@index([vendorId])
  @@map("rfq_responses")
}

enum PerformanceMetricType {
  ON_TIME_DELIVERY
  QUALITY_COMPLAINT
  PRICE_CONSISTENCY
  GENERAL
}

model VendorPerformanceLog {
  id          String                @id @default(uuid())
  tenantId    String
  vendorId    String
  type        PerformanceMetricType @default(GENERAL)
  score       Float // 0.0 to 1.0 or specific value
  referenceId String? // e.g. PO id or GRN id
  notes       String?
  recordedAt  DateTime              @default(now())
  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  vendor      Vendor                @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
  @@index([vendorId])
  @@map("vendor_performance_logs")
}

// ─── Export Documentation Vault ────────────────────────────────────────────────

enum ExportDocType {
  PHYTOSANITARY
  EXPORT_PERMIT
  CUSTOMS_INVOICE
  CERTIFICATE_OF_ORIGIN
}

model ExportDocument {
  id             String        @id @default(uuid())
  tenantId       String
  orderId        String
  type           ExportDocType
  documentNumber String?
  fileUrl        String
  status         String        @default("GENERATED")
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@map("export_documents")
}

// ─── Compliance & Certification Repository ─────────────────────────────────────

enum CertificationType {
  GLOBAL_GAP
  FAIRTRADE
  KFC_SILVER
  MPS
  RAINFOREST_ALLIANCE
  OTHER
}

model Certification {
  id            String            @id @default(uuid())
  tenantId      String
  type          CertificationType
  customName    String? // used when type=OTHER
  issuedBy      String?
  certNumber    String?
  issueDate     DateTime?
  expiryDate    DateTime?
  fileUrl       String? // S3 URL to cert scan/PDF
  status        String            @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED, PENDING
  remindersSent Int               @default(0) // track how many reminders sent
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([expiryDate])
  @@map("certifications")
}

// ─── Logistics & Proof of Delivery ─────────────────────────────────────────────

model Vehicle {
  id             String          @id @default(uuid())
  tenantId       String
  plateNumber    String
  makeModel      String?
  type           String          @default("VAN") // TRUCK, VAN, BIKE
  capacity       Float? // Volume or kg
  refrigerated   Boolean         @default(true)
  status         String          @default("ACTIVE") // ACTIVE, MAINTENANCE
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deliveryRoutes DeliveryRoute[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([plateNumber, tenantId])
  @@index([tenantId])
  @@map("vehicles")
}

model DeliveryRoute {
  id            String         @id @default(uuid())
  tenantId      String
  driverId      String
  vehicleId     String
  status        String         @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  date          DateTime
  startMileage  Float?
  endMileage    Float?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deliveryStops DeliveryStop[]

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  driver  User    @relation(fields: [driverId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([driverId])
  @@index([date])
  @@map("delivery_routes")
}

model DeliveryStop {
  id                    String    @id @default(uuid())
  tenantId              String
  routeId               String
  orderId               String    @unique
  sequenceIndex         Int       @default(0)
  status                String    @default("PENDING") // PENDING, DELIVERED, FAILED
  expectedArrival       DateTime?
  actualArrival         DateTime?
  podSignatureUrl       String?
  podPhotoUrl           String?
  vehicleTempAtDelivery Float?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  route  DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([routeId])
  @@map("delivery_stops")
}

// ─── Financials & Invoicing ───────────────────────────────────────────────────

model Invoice {
  id              String    @id @default(uuid())
  tenantId        String
  orderId         String    @unique
  invoiceNumber   String?
  status          String    @default("DRAFT") // DRAFT, SENT, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  totalAmount     Float
  vatAmount       Float     @default(0)
  whtAmount       Float     @default(0)
  taxRateId       String?
  paidAmount      Float     @default(0)
  currency        String    @default("USD")
  issuedAt        DateTime  @default(now())
  dueDate         DateTime?
  sentAt          DateTime?
  pdfUrl          String?
  remindersSent   Int       @default(0)
  lastReminderAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  order    Order            @relation(fields: [orderId], references: [id])
  taxRate  TaxRate?         @relation(fields: [taxRateId], references: [id])
  payments InvoicePayment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("invoices")
}

// ─── Budgeting & Cost Centres ─────────────────────────────────────────────────

enum CostCentreType {
  PRODUCTION
  PACK_HOUSE
  LOGISTICS
  ADMIN
  SALES
  OTHER
}

model CostCentre {
  id          String         @id @default(uuid())
  tenantId    String
  name        String
  type        CostCentreType
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  budgets Budget[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("cost_centres")
}

model Budget {
  id           String     @id @default(uuid())
  tenantId     String
  costCentreId String
  name         String
  year         Int
  month        Int? // null = annual budget; 1-12 = monthly
  currency     String     @default("USD")
  status       String     @default("DRAFT") // DRAFT, APPROVED, LOCKED
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  costCentre CostCentre   @relation(fields: [costCentreId], references: [id])
  lines      BudgetLine[]

  @@index([tenantId])
  @@index([tenantId, year, month])
  @@map("budgets")
}

model BudgetLine {
  id          String  @id @default(uuid())
  budgetId    String
  accountCode String  // e.g. "5000" COGS, "5100" Payroll
  description String
  budgetedAmt Float
  notes       String?

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("budget_lines")
}

// ─── Payroll Engine ───────────────────────────────────────────────────────────

enum EmploymentType {
  PERMANENT
  CONTRACT
  CASUAL
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  SUSPENDED
  ON_LEAVE
}

model Employee {
  id               String         @id @default(uuid())
  tenantId         String
  userId           String?        @unique // Links to app User if they have login
  employeeNumber   String
  firstName        String
  lastName         String
  email            String?
  phone            String?
  nationalId       String?
  taxPin           String?        // KRA PIN for PAYE
  nhifNumber       String?
  nssfNumber       String?
  bankName         String?
  bankBranch       String?
  accountNumber    String?
  mpesaPhone       String?        // For M-Pesa disbursement
  department       String?        // e.g. PRODUCTION, PACK_HOUSE
  jobTitle         String?
  employmentType   EmploymentType @default(PERMANENT)
  status           EmployeeStatus @default(ACTIVE)
  basicSalary      Float          @default(0)
  isActive         Boolean        @default(true)
  joinedAt         DateTime       @default(now())
  
  // Digital File Enhancements
  contractUrl       String?       // S3 URL to contract PDF
  workPermitId      String?
  workPermitExpiry  DateTime?
  healthCertExpiry  DateTime?
  biometricId       String?        @unique
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  payslips          Payslip[]
  documents         EmployeeDocument[]
  emergencyContacts EmergencyContact[]
  employmentHistory EmploymentHistory[]
  attendanceLogs    AttendanceLog[]
  leaveRequests     LeaveRequest[]
  shiftAssignments  ShiftAssignment[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@map("employees")
}

model EmployeeDocument {
  id             String             @id @default(uuid())
  employeeId     String
  type           EmployeeDocType
  documentNumber String?
  fileUrl        String             // S3 URL
  expiryDate     DateTime?
  status         String             @default("ACTIVE") // ACTIVE, EXPIRED, PENDING
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_documents")
}

enum EmployeeDocType {
  WORK_PERMIT
  HEALTH_CERTIFICATE
  NSSF_CARD
  NHIF_CARD
  KRA_PIN_CERT
  NATIONAL_ID_SCAN
  OTHER
}

model EmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("emergency_contacts")
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(uuid())
  tenantId     String
  employeeId   String
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  status       LeaveStatus @default(PENDING)
  reason       String?
  approvedById String?     // ID of HR manager who approved
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@index([employeeId])
  @@index([tenantId])
  @@map("leave_requests")
}

model Shift {
  id        String   @id @default(uuid())
  tenantId  String
  name      String   // e.g. "Morning Shift"
  startTime String   // e.g. "08:00"
  endTime   String   // e.g. "17:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ShiftAssignment[]
  tenant      Tenant            @relation(fields: [tenantId], references: [id])

  @@map("shifts")
}

model ShiftAssignment {
  id         String   @id @default(uuid())
  tenantId   String
  employeeId String
  shiftId    String
  date       DateTime
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@index([employeeId])
  @@index([shiftId])
  @@map("shift_assignments")
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

model AttendanceLog {
  id         String         @id @default(uuid())
  tenantId   String
  employeeId String
  type       AttendanceType
  timestamp  DateTime       @default(now())
  source     String?        // e.g. "BIOMETRIC_DEVICE_01"
  metadata   Json?          // For storing device IP, battery status, etc.

  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([tenantId])
  @@index([timestamp])
  @@map("attendance_logs")
}

model EmploymentHistory {
  id               String    @id @default(uuid())
  employeeId       String
  companyName      String
  jobTitle         String
  startDate        DateTime
  endDate          DateTime?
  responsibilities String?   // Text/Markdown
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employment_history")
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  APPROVED
  DISBURSED
  CANCELLED
}

model PayrollRun {
  id          String           @id @default(uuid())
  tenantId    String
  runNumber   String
  period      String           // e.g. "2026-04"
  year        Int
  month       Int              // 1–12
  status      PayrollRunStatus @default(DRAFT)
  totalGross  Float            @default(0)
  totalNet    Float            @default(0)
  totalDeductions Float        @default(0)
  notes       String?
  approvedById String?
  approvedAt  DateTime?
  disbursedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payslips Payslip[]

  @@unique([tenantId, period])
  @@index([tenantId])
  @@map("payroll_runs")
}

model Payslip {
  id               String    @id @default(uuid())
  tenantId         String
  payrollRunId     String
  employeeId       String
  basicSalary      Float     @default(0)
  overtime         Float     @default(0)    // hours × rate
  allowances       Float     @default(0)    // housing, transport, etc.
  grossPay         Float     @default(0)
  // Statutory deductions (Kenya) — TODO: implement bracket engine
  paye             Float     @default(0)    // PAYE tax
  nhif             Float     @default(0)    // NHIF contribution
  nssf             Float     @default(0)    // NSSF contribution
  otherDeductions  Float     @default(0)    // loans, advance deductions
  totalDeductions  Float     @default(0)
  netPay           Float     @default(0)
  // Payment tracking
  paymentMethod    String    @default("BANK_TRANSFER") // BANK_TRANSFER, MPESA
  paymentReference String?   // bank ref or M-Pesa transaction code
  paidAt           DateTime?
  pdfUrl           String?   // link to generated payslip PDF
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payslips")
}


model InvoicePayment {
  id          String   @id @default(uuid())
  tenantId    String
  invoiceId   String
  amount      Float
  currency    String   @default("USD")
  method      String   @default("BANK_TRANSFER") // BANK_TRANSFER, MPESA, CASH, CARD
  reference   String?  // payment reference / cheque number
  paidAt      DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_payments")
}

// ─── Farm Operations & Agricultural Stages ─────────────────────────────────────

model SoilTest {
  id         String   @id @default(uuid())
  tenantId   String
  zoneId     String?
  testDate   DateTime
  pHLevel    Float?
  ecLevel    Float? // Salinity
  nitrogen   Float?
  phosphorus Float?
  potassium  Float?
  soilType   String?
  structure  String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  zone       Zone?    @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@map("soil_tests")
}

model LandPrepLog {
  id             String   @id @default(uuid())
  tenantId       String
  zoneId         String
  activityType   String // PLOWING, HARROWING, BED_FORMATION, AMENDMENT
  date           DateTime
  details        String? // bed size, spacing, etc.
  amendmentsUsed String? // lime, compost, manure details
  performedById  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  zone           Zone     @relation(fields: [zoneId], references: [id])
  performedBy    User?    @relation(fields: [performedById], references: [id])

  @@index([tenantId])
  @@map("land_prep_logs")
}

model CropBudget {
  id                     String    @id @default(uuid())
  tenantId               String
  cropCycleId            String    @unique
  laborWorkersReq        Int?
  estimatedLaborCost     Float?
  estimatedInputCost     Float?
  estimatedUtilitiesCost Float?
  totalBudget            Float?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  tenant                 Tenant    @relation(fields: [tenantId], references: [id])
  cropCycle              CropCycle @relation(fields: [cropCycleId], references: [id])

  @@index([tenantId])
  @@map("crop_budgets")
}

model PlantingRecord {
  id          String    @id @default(uuid())
  tenantId    String
  cropCycleId String    @unique
  date        DateTime
  supplier    String?
  lotNumber   String?
  spacing     String? // e.g. "20cm x 20cm"
  density     Float? // plants per sqm
  totalPlants Int
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  cropCycle   CropCycle @relation(fields: [cropCycleId], references: [id])

  @@index([tenantId])
  @@map("planting_records")
}

model IrrigationLog {
  id              String   @id @default(uuid())
  tenantId        String
  zoneId          String
  date            DateTime
  durationMinutes Int?
  volumeLiters    Float?
  method          String // DRIP, SPRINKLER, MANUAL
  fertigationUsed Boolean  @default(false)
  fertilizerType  String?
  npkLevels       String? // e.g. "20-20-20"
  applicationRate Float?
  performedById   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  zone            Zone     @relation(fields: [zoneId], references: [id])
  performedBy     User?    @relation(fields: [performedById], references: [id])

  @@index([tenantId])
  @@map("irrigation_logs")
}

model ScoutingReport {
  id              String     @id @default(uuid())
  tenantId        String
  zoneId          String
  cropCycleId     String?
  date            DateTime
  pestDiseaseName String?
  severity        String // LOW, MEDIUM, HIGH
  observations    String
  actionTaken     String?
  inspectorId     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  zone            Zone       @relation(fields: [zoneId], references: [id])
  cropCycle       CropCycle? @relation(fields: [cropCycleId], references: [id])
  inspector       User       @relation("ScoutingInspector", fields: [inspectorId], references: [id])

  @@index([tenantId])
  @@map("scouting_reports")
}

model CropPerformanceLog {
  id           String    @id @default(uuid())
  tenantId     String
  cropCycleId  String
  date         DateTime
  growthRate   String? // SLOW, NORMAL, FAST
  healthScore  Int? // 1 to 10
  budFormation Boolean   @default(false)
  observations String?
  recordedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  cropCycle    CropCycle @relation(fields: [cropCycleId], references: [id])
  recordedBy   User      @relation(fields: [recordedById], references: [id])

  @@index([tenantId])
  @@map("crop_performance_logs")
}

model PreHarvestQualityLog {
  id           String    @id @default(uuid())
  tenantId     String
  cropCycleId  String
  date         DateTime
  budStage     String? // PEA_SIZE, SHOWING_COLOR, OPENING
  budSizeMm    Float?
  stemLengthCm Float?
  stemStrength String? // WEAK, MEDIUM, STRONG
  colorDev     String?
  inspectorId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  cropCycle    CropCycle @relation(fields: [cropCycleId], references: [id])
  inspector    User      @relation(fields: [inspectorId], references: [id])

  @@index([tenantId])
  @@map("pre_harvest_quality_logs")
}

model HarvestRecord {
  id            String    @id @default(uuid())
  tenantId      String
  cropCycleId   String
  date          DateTime
  quantityStems Int // or total stems
  weightKg      Float?
  rejectedStems Int?
  notes         String?
  supervisorId  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  cropCycle     CropCycle @relation(fields: [cropCycleId], references: [id])
  supervisor    User      @relation(fields: [supervisorId], references: [id])

  @@index([tenantId])
  @@map("harvest_records")
}
