// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Multi-tenancy ──────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  @@map("tenants")
}

// ── RBAC & Users ──────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, tenantId])
  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actorAuditLogs AuditLog[] @relation("ActorLogs")

  @@map("users")
}

// ── Audit Trail ────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  
  actorId    String?
  actor      User?    @relation("ActorLogs", fields: [actorId], references: [id])
  
  action     String   // e.g., "CREATE_ORDER", "UPDATE_CROP_CYCLE"
  entityType String   // e.g., "Order", "CropCycle"
  entityId   String?
  
  beforeState Json?
  afterState  Json?
  
  timestamp  DateTime @default(now())

  @@index([tenantId])
  @@index([timestamp])
  @@map("audit_logs")
}
