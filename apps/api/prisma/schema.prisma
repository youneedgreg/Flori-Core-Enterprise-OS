generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  status         TenantStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  auditLogs      AuditLog[]
  communications Communication[]
  customers      Customer[]
  leads          Lead[]
  contactLogs    ContactLog[]
  farmProfile    FarmProfile?
  iotDevices     IoTDevice[]
  notifications  Notification[]
  orders         Order[]
  payroll        PayrollRecord[]
  products       Product[]
  roles          Role[]
  telemetry      TelemetryReading[]
  users          User[]
  zones          Zone[]

  settings        Json?            @default("{}")
  unitPreference  UnitSystem       @default(METRIC)
  varieties       Variety[]
  cropCycles      CropCycle[]
  cropSchedules   CropSchedule[]
  alerts          Alert[]
  automationRules AutomationRule[]
  labourLogs      LabourLog[]
  sprayLogs       SprayLog[]

  flowerBatches   FlowerBatch[]
  qcLogs          QCLog[]
  flowerInventory FlowerInventory[]
  coldRoomEvents  ColdRoomEvent[]
  packedBoxes     PackedBox[]
  wastageLogs     WastageLog[]

  storeItems            StoreItem[]
  storeStock            StoreStock[]
  storeMovements        StoreMovement[]
  vendors               Vendor[]
  purchaseRequests      PurchaseRequest[]
  purchaseOrders        PurchaseOrder[]
  rfqs                  Rfq[]
  rfqResponses          RfqResponse[]
  vendorPerformanceLogs VendorPerformanceLog[]
  goodsReceivedNotes    GoodsReceivedNote[]
  financialJournals     FinancialJournal[]
  exportDocuments       ExportDocument[]

  @@map("tenants")
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

model Role {
  id          String   @id @default(uuid())
  name        String
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  users       User[]

  @@unique([name, tenantId])
  @@map("roles")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  roleId         String
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  actorAuditLogs AuditLog[]      @relation("ActorLogs")
  notifications  Notification[]  @relation("UserNotifications")
  payrollRecords PayrollRecord[]
  labourLogs     LabourLog[]
  role           Role            @relation(fields: [roleId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  contactLogs    ContactLog[]
  leads          Lead[]

  sprayLogs       SprayLog[]      @relation("SprayApplicator")
  overridenSprays SprayLog[]      @relation("SprayOverrider")
  coldRoomEvents  ColdRoomEvent[]

  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  beforeState Json?
  afterState  Json?
  timestamp   DateTime @default(now())
  actor       User?    @relation("ActorLogs", fields: [actorId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([timestamp])
  @@map("audit_logs")
}

model Communication {
  id         String   @id @default(uuid())
  threadId   String?
  entityType String?
  entityId   String?
  direction  String
  channel    String
  subject    String?
  body       String
  tenantId   String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([threadId])
  @@map("communications")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation("UserNotifications", fields: [userId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("notifications")
}

model FarmProfile {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  name            String
  location        String?
  gpsCoordinates  String?
  certifications  String[]
  logoUrl         String?
  contactEmail    String?
  contactPhone    String?
  defaultCurrency String   @default("KES")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@map("farm_profiles")
}

model Zone {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  type          ZoneType  @default(GREENHOUSE)
  areaSqm       Float?
  plantCount    Float?
  lastWatered   DateTime?
  cropVarieties String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isArchived    Boolean   @default(false)
  layout        Json?

  // Alert Thresholds
  minTemp     Float? @default(0)
  maxTemp     Float? @default(40)
  minHumidity Float? @default(0)
  maxHumidity Float? @default(100)

  devices        IoTDevice[]
  cropCycles     CropCycle[]
  labourLogs     LabourLog[]
  sprayLogs      SprayLog[]
  coldEvents     ColdRoomEvent[]
  storeStock     StoreStock[]
  storeMovements StoreMovement[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id])

  @@map("zones")
}

enum ZoneType {
  GREENHOUSE
  COLD_ROOM
  PACKING_AREA
  OFFICE
  WAREHOUSE
  STORE
}

model IoTDevice {
  id         String             @id @default(uuid())
  tenantId   String
  zoneId     String?
  type       String
  macAddress String             @unique
  mqttTopic  String
  status     String             @default("ACTIVE")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  zone       Zone?              @relation(fields: [zoneId], references: [id])
  readings   TelemetryReading[]

  @@map("iot_devices")
}

enum CustomerType {
  RETAILER
  EXPORTER
  AUCTION_HOUSE
  DIRECT_BUYER
}

enum CustomerSegment {
  LOCAL_RETAIL
  EXPORT
  SPOT_MARKET
}

model Customer {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  email          String?
  phone          String?
  contactPerson  String?
  address        String?
  country        String?
  type           CustomerType    @default(DIRECT_BUYER)
  segment        CustomerSegment @default(LOCAL_RETAIL)
  notes          String?
  commissionRate Float? // For auction houses
  creditLimit    Float? // For retailers/direct buyers
  paymentTerms   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  orders      Order[]
  contactLogs ContactLog[]
  leads       Lead[]

  @@map("customers")
}

model ContactLog {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  userId     String // Sales Rep / Contact person
  type       String // EMAIL, CALL, MEETING, NOTE
  subject    String?
  notes      String
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@map("contact_logs")
}

enum LeadStatus {
  PROSPECT
  NEGOTIATION
  CONTRACT
  ACTIVE
  LOST
}

model Lead {
  id           String     @id @default(uuid())
  tenantId     String
  customerId   String? // Optional link if converted
  name         String // Company / Lead Name
  email        String?
  phone        String?
  status       LeadStatus @default(PROSPECT)
  value        Float? // Deal size
  assignedToId String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer   Customer? @relation(fields: [customerId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  assignedTo User?     @relation(fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@map("leads")
}

model Order {
  id                 String             @id @default(uuid())
  tenantId           String
  type               OrderType          @default(SPOT_ORDER)
  status             OrderStatus        @default(DRAFT)
  orderNumber        String?
  customerId         String
  items              Json
  totalAmount        Float
  currency           String             @default("USD")
  deliveryDate       DateTime?
  shipmentDate       DateTime?
  notes              String?
  isTemplate         Boolean            @default(false)
  parentTemplateId   String?
  templateFrequency  TemplateFrequency?
  nextGenerationDate DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  packedBoxes     PackedBox[]
  template        Order?           @relation("OrderTemplates", fields: [parentTemplateId], references: [id])
  generatedOrders Order[]          @relation("OrderTemplates")
  exportDocuments ExportDocument[]

  @@index([tenantId])
  @@index([status])
  @@index([isTemplate])
  @@map("orders")
}

model TelemetryReading {
  id         String    @default(uuid())
  tenantId   String
  deviceId   String
  sensorType String    @default("MOISTURE") // MOISTURE, TEMP, EC, PH
  value      Float
  unit       String?
  timestamp  DateTime  @default(now())
  device     IoTDevice @relation(fields: [deviceId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@id([id, timestamp])
  @@index([tenantId])
  @@index([deviceId])
  @@index([timestamp])
  @@map("telemetry_readings")
}

model Alert {
  id        String   @id @default(uuid())
  tenantId  String
  deviceId  String?
  zoneId    String?
  type      String   @default("THRESHOLD_BREACH")
  severity  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  message   String
  status    String   @default("OPEN") // OPEN, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("alerts")
}

model AutomationRule {
  id         String   @id @default(uuid())
  tenantId   String
  zoneId     String?
  name       String
  sensorType String
  operator   String   @default("LT") // LT, GT, EQ
  threshold  Float
  action     String   @default("NOTIFY") // NOTIFY, IRRIGATE_ON
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("automation_rules")
}

model LabourLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String // Employee (System User)
  zoneId      String
  taskType    String // HARVEST, SPRAY, PRUNE, etc.
  hours       Float
  stemsCut    Int? // For productivity metrics
  timestamp   DateTime @default(now())
  gpsLocation Json? // { lat: number, lng: number }

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  zone   Zone   @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
  @@map("labour_logs")
}

model PayrollRecord {
  id          String        @id @default(uuid())
  tenantId    String
  userId      String
  amount      Float
  currency    String        @default("KES")
  status      PayrollStatus @default(PENDING)
  period      String
  paymentDate DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  type        PayrollType @default(FIXED)
  hoursWorked Float?
  hourlyRate  Float?
  baseAmount  Float?

  @@index([tenantId])
  @@index([userId])
  @@map("payroll_records")
}

enum PayrollType {
  FIXED
  HOURLY
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PICKING
  DISPATCHED
  DELIVERED
  INVOICED
}

enum OrderType {
  STANDING_ORDER
  SPOT_ORDER
  EXPORT_CONTRACT
}

enum TemplateFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PayrollStatus {
  PENDING
  PAID
  CANCELLED
}

model Product {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  sku       String   @unique
  stock     Int      @default(0)
  unitPrice Float
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("products")
}

model Variety {
  id                    String            @id @default(uuid())
  tenantId              String
  name                  String
  targetStemLength      Float? // in cm
  targetStemCountPerSqm Float? // units per sqm
  bloomTime             Int? // days from planting
  marketGrade           String?
  defaultCostPerStem    Float?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  tenant                Tenant            @relation(fields: [tenantId], references: [id])
  cropCycles            CropCycle[]
  flowerBatches         FlowerBatch[]
  flowerInventory       FlowerInventory[]
  packedBoxes           PackedBox[]
  wastageLogs           WastageLog[]

  @@map("varieties")
}

model CropCycle {
  id                   String          @id @default(uuid())
  tenantId             String
  varietyId            String
  zoneId               String? // Greenhouse block
  startDate            DateTime
  projectedHarvestDate DateTime?
  actualHarvestDate    DateTime?
  actualHarvestYield   Int? // Stems
  status               CropCycleStatus @default(PLANNED)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  variety       Variety        @relation(fields: [varietyId], references: [id])
  zone          Zone?          @relation(fields: [zoneId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  schedules     CropSchedule[]
  flowerBatches FlowerBatch[]

  @@map("crop_cycles")
}

enum CropCycleStatus {
  PLANNED
  PLANTED
  GROWING
  HARVESTING
  COMPLETED
  CANCELLED
}

model CropSchedule {
  id            String       @id @default(uuid())
  tenantId      String
  cropCycleId   String
  type          ScheduleType
  taskName      String
  scheduledDate DateTime
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@map("crop_schedules")
}

enum ScheduleType {
  SPRAY
  FERTILIZER
  PRUNING
  OTHER
}

model SprayLog {
  id               String   @id @default(uuid())
  tenantId         String
  zoneId           String
  chemicalName     String
  epaRegNo         String
  quantity         Float
  unit             String // L, Kg, ml, g
  phiDays          Int      @default(0)
  applicatorId     String
  appliedAt        DateTime @default(now())
  harvestAllowedAt DateTime
  notes            String?
  overrideReason   String?
  overriddenById   String?

  tenant       Tenant @relation(fields: [tenantId], references: [id])
  zone         Zone   @relation(fields: [zoneId], references: [id])
  applicator   User   @relation("SprayApplicator", fields: [applicatorId], references: [id])
  overriddenBy User?  @relation("SprayOverrider", fields: [overriddenById], references: [id])

  @@index([tenantId])
  @@index([zoneId])
  @@index([appliedAt])
  @@map("spray_logs")
}

model FlowerBatch {
  id             String      @id @default(uuid())
  tenantId       String
  cropCycleId    String
  varietyId      String
  batchNumber    String      @unique // FLR-YYYYMMDD-XXX
  quantityIntake Int
  status         BatchStatus @default(QC_PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  cropCycle      CropCycle       @relation(fields: [cropCycleId], references: [id])
  variety        Variety         @relation(fields: [varietyId], references: [id])
  qcLogs         QCLog[]
  coldRoomEvents ColdRoomEvent[]
  packedBoxes    PackedBox[]

  @@index([tenantId])
  @@index([batchNumber])
  @@map("flower_batches")
}

enum BatchStatus {
  QC_PENDING
  GRADED
  REJECTED
  IN_COLD_STORAGE
  SHIPPED
}

model QCLog {
  id            String   @id @default(uuid())
  tenantId      String
  batchId       String
  inspectorId   String? // User who did the QC
  stemLength    Float
  bloomStage    String
  headDiameter  Float
  defects       Json // Array of strings or object
  assignedGrade QCGrade
  notes         String? // For rejection reasons or extra info
  createdAt     DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  batch  FlowerBatch @relation(fields: [batchId], references: [id])

  @@index([tenantId])
  @@index([batchId])
  @@map("qc_logs")
}

model FlowerInventory {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  varietyId String
  variety   Variety  @relation(fields: [varietyId], references: [id])
  grade     QCGrade
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, varietyId, grade])
  @@index([tenantId])
  @@map("flower_inventory")
}

enum QCGrade {
  A
  B
  C
  REJECT
}

model ColdRoomEvent {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  zoneId    String
  zone      Zone              @relation(fields: [zoneId], references: [id])
  batchId   String
  batch     FlowerBatch       @relation(fields: [batchId], references: [id])
  type      ColdRoomEventType
  quantity  Int
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  timestamp DateTime          @default(now())

  @@index([tenantId])
  @@index([batchId])
  @@index([zoneId])
  @@map("cold_room_events")
}

enum ColdRoomEventType {
  CHECK_IN
  CHECK_OUT
}

model PackedBox {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  batchId       String?
  batch         FlowerBatch? @relation(fields: [batchId], references: [id])
  varietyId     String
  variety       Variety      @relation(fields: [varietyId], references: [id])
  grade         QCGrade
  boxId         String       @unique
  bunchSize     Int
  bunchesPerBox Int
  totalStems    Int
  packDate      DateTime     @default(now())
  destination   String?
  status        BoxStatus    @default(PACKED)
  labelUrl      String?
  orderId       String?
  order         Order?       @relation(fields: [orderId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId])
  @@index([boxId])
  @@map("packed_boxes")
}

enum BoxStatus {
  PACKED
  IN_COLD_STORAGE
  ALLOCATED
  SHIPPED
  DELIVERED
  WASTED
}

model WastageLog {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  varietyId    String
  variety      Variety       @relation(fields: [varietyId], references: [id])
  grade        QCGrade
  quantity     Int // stems wasted
  reason       WastageReason
  costPerStem  Float?
  costImpact   Float? // quantity × costPerStem
  notes        String?
  recordedById String?
  createdAt    DateTime      @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("wastage_logs")
}

enum WastageReason {
  TEMPERATURE_DAMAGE
  DISEASE
  PEST_DAMAGE
  PHYSICAL_DAMAGE
  EXPIRED
  GRADING_REJECT
  OTHER
}

// ─── Stores & Procurement ──────────────────────────────────────────────────────

enum StoreItemCategory {
  FERTILISER
  PESTICIDE
  SEED
  PACKAGING
  PPE
  SPARE_PART
  OTHER
}

enum StoreMovementType {
  GRN // Goods Received Note (stock in)
  ISSUE // Issued to a zone / activity
  RETURN // Returned from zone
  WRITE_OFF // Written off (damaged, expired, lost)
}

model StoreItem {
  id                 String              @id @default(uuid())
  tenantId           String
  name               String
  sku                String
  category           StoreItemCategory   @default(OTHER)
  unit               String              @default("units") // kg, litres, pcs, boxes …
  description        String?
  minStockLevel      Float               @default(0)
  reorderPoint       Float               @default(0)
  maxStockLevel      Float               @default(0) // 0 = not set; engine uses reorderPoint*2 fallback
  unitCost           Float               @default(0)
  lastUnitPrice      Float? // updated on each GRN
  preferredVendorId  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  preferredVendor    Vendor?             @relation(fields: [preferredVendorId], references: [id])
  stock              StoreStock[]
  movements          StoreMovement[]
  purchaseRequests   PurchaseRequest[]
  purchaseOrderItems PurchaseOrderItem[]
  grnItems           GrnItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("store_items")
}

model StoreStock {
  id        String    @id @default(uuid())
  tenantId  String
  itemId    String
  zoneId    String
  quantity  Float     @default(0)
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  item      StoreItem @relation(fields: [itemId], references: [id])
  zone      Zone      @relation(fields: [zoneId], references: [id])

  @@unique([tenantId, itemId, zoneId])
  @@index([tenantId])
  @@map("store_stock")
}

model StoreMovement {
  id          String            @id @default(uuid())
  tenantId    String
  itemId      String
  zoneId      String // Source / owning zone
  type        StoreMovementType
  quantity    Float
  reference   String? // PO number, GRN ref, etc.
  toZoneId    String? // Destination zone for ISSUE movements
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  item        StoreItem         @relation(fields: [itemId], references: [id])
  zone        Zone              @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@index([itemId])
  @@index([createdAt])
  @@map("store_movements")
}

// ─── Vendors ──────────────────────────────────────────────────────────────────

model Vendor {
  id                 String                 @id @default(uuid())
  tenantId           String
  name               String
  contactPerson      String?
  email              String
  phone              String?
  address            String?
  paymentTerms       String? // e.g. "Net 30", "COD"
  taxPin             String?
  bankDetails        Json? // { bankName, accountNo, branch, swiftCode }
  notes              String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  storeItems         StoreItem[] // items where this is the preferred vendor
  purchaseRequests   PurchaseRequest[]
  purchaseOrders     PurchaseOrder[]
  rfqResponses       RfqResponse[]
  performanceLogs    VendorPerformanceLog[]
  goodsReceivedNotes GoodsReceivedNote[]

  website        String?
  certifications String[] @default([])

  @@index([tenantId])
  @@map("vendors")
}

// ─── Purchase Requests ────────────────────────────────────────────────────────

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED // Converted to a PurchaseOrder
}

model PurchaseRequest {
  id              String                @id @default(uuid())
  tenantId        String
  status          PurchaseRequestStatus @default(PENDING)
  generatedBy     String // "AUTO" or userId of requester
  itemId          String
  vendorId        String?
  currentStock    Float // stock at time of generation
  reorderPoint    Float // snapshot of item's reorderPoint
  suggestedQty    Float // engine-calculated recommended quantity
  approvedQty     Float? // Gold Admin may adjust before approving
  lastUnitPrice   Float? // snapshot of item's lastUnitPrice / unitCost
  estimatedTotal  Float? // suggestedQty × lastUnitPrice
  notes           String? // auto-generated note or admin comment
  rejectionReason String?
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  item            StoreItem             @relation(fields: [itemId], references: [id])
  vendor          Vendor?               @relation(fields: [vendorId], references: [id])
  purchaseOrder   PurchaseOrder?

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_requests")
}

// ─── Purchase Orders ──────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  SENT // Emailed to vendor
  ACKNOWLEDGED // Vendor confirmed receipt
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                 String              @id @default(uuid())
  tenantId           String
  poNumber           String              @unique // e.g. PO-2026-00001
  status             PurchaseOrderStatus @default(DRAFT)
  vendorId           String
  purchaseRequestId  String?             @unique
  expectedDelivery   DateTime?
  totalAmount        Float               @default(0)
  notes              String?
  vendorEmailSentAt  DateTime?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  vendor             Vendor              @relation(fields: [vendorId], references: [id])
  purchaseRequest    PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  items              PurchaseOrderItem[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

enum GrnStatus {
  PENDING
  RECONCILED
  DISCREPANCY
}

model GoodsReceivedNote {
  id               String    @id @default(uuid())
  tenantId         String
  poId             String
  grnNumber        String    @unique // e.g. GRN-2026-00001
  status           GrnStatus @default(PENDING)
  vendorId         String
  receivedDate     DateTime  @default(now())
  receivedById     String
  notes            String?
  discrepancyNotes String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  items         GrnItem[]

  @@index([tenantId])
  @@index([poId])
  @@map("goods_received_notes")
}

model GrnItem {
  id                 String            @id @default(uuid())
  grnId              String
  itemId             String
  quantityReceived   Float
  unitPriceReceived  Float
  totalPriceReceived Float
  poItemId           String? // Link to specific PO line item
  notes              String?
  grn                GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item               StoreItem         @relation(fields: [itemId], references: [id])

  @@index([grnId])
  @@map("grn_items")
}

// ─── Financials (Integrated Ledger) ──────────────────────────────────────────

model FinancialJournal {
  id          String         @id @default(uuid())
  tenantId    String
  reference   String? // e.g. "GRN-0001", "INV-0001"
  description String
  date        DateTime       @default(now())
  userId      String? // User who recorded the entry
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  entries     JournalEntry[]

  @@index([tenantId])
  @@map("financial_journals")
}

model JournalEntry {
  id          String           @id @default(uuid())
  journalId   String
  accountCode String // e.g. "11000" (Inventory), "21000" (AP Liability)
  debit       Float            @default(0)
  credit      Float            @default(0)
  journal     FinancialJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
  @@map("journal_entries")
}

model PurchaseOrderItem {
  id         String        @id @default(uuid())
  poId       String
  itemId     String
  quantity   Float
  unitPrice  Float
  totalPrice Float
  notes      String?
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item       StoreItem     @relation(fields: [itemId], references: [id])

  @@index([poId])
  @@map("purchase_order_items")
}

// ─── RFQs & Performance ──────────────────────────────────────────────────────

enum RfqStatus {
  DRAFT
  SENT
  CLOSED
  CANCELLED
}

model Rfq {
  id         String        @id @default(uuid())
  tenantId   String
  status     RfqStatus     @default(DRAFT)
  items      Json // [{ itemId: string, quantity: number, notes: string }]
  notes      String?
  expiryDate DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  responses  RfqResponse[]

  @@index([tenantId])
  @@map("rfqs")
}

enum RfqResponseStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model RfqResponse {
  id           String            @id @default(uuid())
  rfqId        String
  vendorId     String
  tenantId     String
  unitPrice    Float
  totalAmount  Float
  currency     String            @default("USD")
  deliveryDays Int? // Lead time in days
  validUntil   DateTime?
  notes        String?
  status       RfqResponseStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  rfq          Rfq               @relation(fields: [rfqId], references: [id])
  vendor       Vendor            @relation(fields: [vendorId], references: [id])
  tenant       Tenant            @relation(fields: [tenantId], references: [id])

  @@index([rfqId])
  @@index([vendorId])
  @@map("rfq_responses")
}

enum PerformanceMetricType {
  ON_TIME_DELIVERY
  QUALITY_COMPLAINT
  PRICE_CONSISTENCY
  GENERAL
}

model VendorPerformanceLog {
  id          String                @id @default(uuid())
  tenantId    String
  vendorId    String
  type        PerformanceMetricType @default(GENERAL)
  score       Float // 0.0 to 1.0 or specific value
  referenceId String? // e.g. PO id or GRN id
  notes       String?
  recordedAt  DateTime              @default(now())
  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  vendor      Vendor                @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
  @@index([vendorId])
  @@map("vendor_performance_logs")
}

// ─── Export Documentation Vault ────────────────────────────────────────────────

enum ExportDocType {
  PHYTOSANITARY
  EXPORT_PERMIT
  CUSTOMS_INVOICE
  CERTIFICATE_OF_ORIGIN
}

model ExportDocument {
  id             String        @id @default(uuid())
  tenantId       String
  orderId        String
  type           ExportDocType
  documentNumber String?
  fileUrl        String
  status         String        @default("GENERATED")
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@map("export_documents")
}
