// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ── Multi-tenancy ──────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users          User[]
  roles          Role[]
  auditLogs      AuditLog[]
  communications Communication[]
  notifications  Notification[]
  farmProfile    FarmProfile?
  zones          Zone[]
  iotDevices     IoTDevice[]

  @@map("tenants")
}

// ── RBAC & Users ──────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, tenantId])
  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actorAuditLogs AuditLog[] @relation("ActorLogs")
  notifications  Notification[] @relation("UserNotifications")

  @@map("users")
}

// ── Audit Trail ────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  
  actorId    String?
  actor      User?    @relation("ActorLogs", fields: [actorId], references: [id])
  
  action     String   // e.g., "CREATE_ORDER", "UPDATE_CROP_CYCLE"
  entityType String   // e.g., "Order", "CropCycle"
  entityId   String?
  
  beforeState Json?
  afterState  Json?
  
  timestamp  DateTime @default(now())

  @@index([tenantId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ── Communications ──────────────────────────────────────────────────

model Communication {
  id         String   @id @default(uuid())
  threadId   String?
  entityType String?  // e.g., "Order", "Vendor"
  entityId   String?
  direction  String   // "INBOUND" or "OUTBOUND"
  channel    String   // "EMAIL" or "WHATSAPP"
  subject    String?
  body       String
  
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([threadId])
  @@map("communications")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserNotifications", fields: [userId], references: [id])
  
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  
  title      String
  message    String
  isRead     Boolean  @default(false)
  
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@map("notifications")
}

// ── Onboarding & Farm Setup ────────────────────────────────────────

model FarmProfile {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  location       String?
  gpsCoordinates String?
  certifications String[]
  logoUrl        String?
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("farm_profiles")
}

model Zone {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  areaSqm       Float?
  cropVarieties String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  devices       IoTDevice[]

  @@map("zones")
}

model IoTDevice {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  zoneId      String?
  zone        Zone?    @relation(fields: [zoneId], references: [id])
  type        String   // e.g. "MOISTURE", "TEMPERATURE"
  macAddress  String   @unique
  mqttTopic   String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("iot_devices")
}
