generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  status         TenantStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  auditLogs      AuditLog[]
  communications Communication[]
  customers      Customer[]
  farmProfile    FarmProfile?
  iotDevices     IoTDevice[]
  notifications  Notification[]
  orders         Order[]
  payroll        PayrollRecord[]
  products       Product[]
  roles          Role[]
  telemetry      TelemetryReading[]
  users          User[]
  zones          Zone[]

  settings       Json?           @default("{}")
  unitPreference UnitSystem      @default(METRIC)
  @@map("tenants")
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

model Role {
  id          String   @id @default(uuid())
  name        String
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  users       User[]

  @@unique([name, tenantId])
  @@map("roles")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  roleId         String
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  actorAuditLogs AuditLog[]      @relation("ActorLogs")
  notifications  Notification[]  @relation("UserNotifications")
  payrollRecords PayrollRecord[]
  role           Role            @relation(fields: [roleId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])

  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  beforeState Json?
  afterState  Json?
  timestamp   DateTime @default(now())
  actor       User?    @relation("ActorLogs", fields: [actorId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([timestamp])
  @@map("audit_logs")
}

model Communication {
  id         String   @id @default(uuid())
  threadId   String?
  entityType String?
  entityId   String?
  direction  String
  channel    String
  subject    String?
  body       String
  tenantId   String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([threadId])
  @@map("communications")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation("UserNotifications", fields: [userId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("notifications")
}

model FarmProfile {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  name           String
  location       String?
  gpsCoordinates String?
  certifications String[]
  logoUrl        String?
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@map("farm_profiles")
}

model Zone {
  id            String      @id @default(uuid())
  tenantId      String
  name          String
  areaSqm       Float?
  cropVarieties String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  isArchived    Boolean     @default(false)
  layout        Json?
  devices       IoTDevice[]
  tenant        Tenant      @relation(fields: [tenantId], references: [id])

  @@map("zones")
}

model IoTDevice {
  id         String             @id @default(uuid())
  tenantId   String
  zoneId     String?
  type       String
  macAddress String             @unique
  mqttTopic  String
  status     String             @default("ACTIVE")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  zone       Zone?              @relation(fields: [zoneId], references: [id])
  readings   TelemetryReading[]

  @@map("iot_devices")
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  address   String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  orders    Order[]

  @@map("customers")
}

model Order {
  id           String      @id @default(uuid())
  tenantId     String
  type         OrderType   @default(EXPORT)
  status       OrderStatus @default(PENDING)
  customerId   String
  items        Json
  totalAmount  Float
  currency     String      @default("USD")
  shipmentDate DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  customer     Customer    @relation(fields: [customerId], references: [id])
  tenant       Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("orders")
}

model TelemetryReading {
  id        String    @id @default(uuid())
  tenantId  String
  deviceId  String
  value     Float
  unit      String?
  timestamp DateTime  @default(now())
  device    IoTDevice @relation(fields: [deviceId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([deviceId])
  @@index([timestamp])
  @@map("telemetry_readings")
}

model PayrollRecord {
  id          String        @id @default(uuid())
  tenantId    String
  userId      String
  amount      Float
  currency    String        @default("KES")
  status      PayrollStatus @default(PENDING)
  period      String
  paymentDate DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  type        PayrollType   @default(FIXED)
  hoursWorked Float?
  hourlyRate  Float?
  baseAmount  Float?

  @@index([tenantId])
  @@index([userId])
  @@map("payroll_records")
}

enum PayrollType {
  FIXED
  HOURLY
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PACKING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderType {
  EXPORT
  LOCAL
}

enum PayrollStatus {
  PENDING
  PAID
  CANCELLED
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  sku         String   @unique
  stock       Int      @default(0)
  unitPrice   Float
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("products")
}
