generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  status         TenantStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  auditLogs      AuditLog[]
  communications Communication[]
  customers      Customer[]
  farmProfile    FarmProfile?
  iotDevices     IoTDevice[]
  notifications  Notification[]
  orders         Order[]
  payroll        PayrollRecord[]
  products       Product[]
  roles          Role[]
  telemetry      TelemetryReading[]
  users          User[]
  zones          Zone[]

  settings       Json?           @default("{}")
  unitPreference UnitSystem      @default(METRIC)
  varieties      Variety[]
  cropCycles     CropCycle[]
  cropSchedules  CropSchedule[]
  alerts         Alert[]
  automationRules AutomationRule[]
  labourLogs     LabourLog[]
  sprayLogs      SprayLog[]
  @@map("tenants")
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

model Role {
  id          String   @id @default(uuid())
  name        String
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  users       User[]

  @@unique([name, tenantId])
  @@map("roles")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  roleId         String
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  actorAuditLogs AuditLog[]      @relation("ActorLogs")
  notifications  Notification[]  @relation("UserNotifications")
  payrollRecords PayrollRecord[]
  labourLogs     LabourLog[]
  role           Role            @relation(fields: [roleId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])

  sprayLogs      SprayLog[]      @relation("SprayApplicator")
  overridenSprays SprayLog[]     @relation("SprayOverrider")

  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  beforeState Json?
  afterState  Json?
  timestamp   DateTime @default(now())
  actor       User?    @relation("ActorLogs", fields: [actorId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([timestamp])
  @@map("audit_logs")
}

model Communication {
  id         String   @id @default(uuid())
  threadId   String?
  entityType String?
  entityId   String?
  direction  String
  channel    String
  subject    String?
  body       String
  tenantId   String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([threadId])
  @@map("communications")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation("UserNotifications", fields: [userId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("notifications")
}

model FarmProfile {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  name           String
  location       String?
  gpsCoordinates String?
  certifications String[]
  logoUrl        String?
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@map("farm_profiles")
}

model Zone {
  id            String      @id @default(uuid())
  tenantId      String
  name          String
  areaSqm       Float?
  plantCount    Float?
  lastWatered   DateTime?
  cropVarieties String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  isArchived    Boolean     @default(false)
  layout        Json?
  devices       IoTDevice[]
  cropCycles    CropCycle[]
  labourLogs    LabourLog[]
  sprayLogs     SprayLog[]
  tenant        Tenant      @relation(fields: [tenantId], references: [id])

  @@map("zones")
}

model IoTDevice {
  id         String             @id @default(uuid())
  tenantId   String
  zoneId     String?
  type       String
  macAddress String             @unique
  mqttTopic  String
  status     String             @default("ACTIVE")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  zone       Zone?              @relation(fields: [zoneId], references: [id])
  readings   TelemetryReading[]

  @@map("iot_devices")
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  address   String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  orders    Order[]

  @@map("customers")
}

model Order {
  id           String      @id @default(uuid())
  tenantId     String
  type         OrderType   @default(EXPORT)
  status       OrderStatus @default(PENDING)
  customerId   String
  items        Json
  totalAmount  Float
  currency     String      @default("USD")
  shipmentDate DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  customer     Customer    @relation(fields: [customerId], references: [id])
  tenant       Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("orders")
}

model TelemetryReading {
  id         String   @default(uuid())
  tenantId   String
  deviceId   String
  sensorType String   @default("MOISTURE") // MOISTURE, TEMP, EC, PH
  value      Float
  unit       String?
  timestamp  DateTime @default(now())
  device     IoTDevice @relation(fields: [deviceId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@id([id, timestamp])
  @@index([tenantId])
  @@index([deviceId])
  @@index([timestamp])
  @@map("telemetry_readings")
}

model Alert {
  id        String   @id @default(uuid())
  tenantId  String
  deviceId  String?
  zoneId    String?
  type      String   @default("THRESHOLD_BREACH")
  severity  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  message   String
  status    String   @default("OPEN") // OPEN, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("alerts")
}

model AutomationRule {
  id         String   @id @default(uuid())
  tenantId   String
  zoneId     String?
  name       String
  sensorType String
  operator   String   @default("LT") // LT, GT, EQ
  threshold  Float
  action     String   @default("NOTIFY") // NOTIFY, IRRIGATE_ON
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("automation_rules")
}

model LabourLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String   // Employee (System User)
  zoneId      String
  taskType    String   // HARVEST, SPRAY, PRUNE, etc.
  hours       Float
  stemsCut    Int?     // For productivity metrics
  timestamp   DateTime @default(now())
  gpsLocation Json?    // { lat: number, lng: number }
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  zone        Zone     @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
  @@map("labour_logs")
}

model PayrollRecord {
  id          String        @id @default(uuid())
  tenantId    String
  userId      String
  amount      Float
  currency    String        @default("KES")
  status      PayrollStatus @default(PENDING)
  period      String
  paymentDate DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  type        PayrollType   @default(FIXED)
  hoursWorked Float?
  hourlyRate  Float?
  baseAmount  Float?

  @@index([tenantId])
  @@index([userId])
  @@map("payroll_records")
}

enum PayrollType {
  FIXED
  HOURLY
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PACKING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderType {
  EXPORT
  LOCAL
}

enum PayrollStatus {
  PENDING
  PAID
  CANCELLED
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  sku         String   @unique
  stock       Int      @default(0)
  unitPrice   Float
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("products")
}

model Variety {
  id                     String      @id @default(uuid())
  tenantId               String
  name                   String
  targetStemLength       Float?      // in cm
  targetStemCountPerSqm  Float?      // units per sqm
  bloomTime              Int?        // days from planting
  marketGrade            String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  tenant                 Tenant      @relation(fields: [tenantId], references: [id])
  cropCycles             CropCycle[]

  @@map("varieties")
}

model CropCycle {
  id                    String          @id @default(uuid())
  tenantId              String
  varietyId             String
  zoneId                String?         // Greenhouse block
  startDate             DateTime
  projectedHarvestDate  DateTime?
  actualHarvestDate    DateTime?
  actualHarvestYield   Int?            // Stems
  status                CropCycleStatus @default(PLANNED)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  
  variety               Variety         @relation(fields: [varietyId], references: [id])
  zone                  Zone?           @relation(fields: [zoneId], references: [id])
  tenant                Tenant          @relation(fields: [tenantId], references: [id])
  schedules             CropSchedule[]

  @@map("crop_cycles")
}

enum CropCycleStatus {
  PLANNED
  PLANTED
  GROWING
  HARVESTING
  COMPLETED
  CANCELLED
}

model CropSchedule {
  id            String       @id @default(uuid())
  tenantId      String
  cropCycleId   String
  type          ScheduleType
  taskName      String
  scheduledDate DateTime
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  cropCycle     CropCycle    @relation(fields: [cropCycleId], references: [id])
  tenant        Tenant       @relation(fields: [tenantId], references: [id])

  @@map("crop_schedules")
}

enum ScheduleType {
  SPRAY
  FERTILIZER
  PRUNING
  OTHER
}

model SprayLog {
  id               String   @id @default(uuid())
  tenantId         String
  zoneId           String
  chemicalName     String
  epaRegNo         String
  quantity         Float
  unit             String   // L, Kg, ml, g
  phiDays          Int      @default(0)
  applicatorId     String
  appliedAt        DateTime @default(now())
  harvestAllowedAt DateTime
  notes            String?
  overrideReason   String?
  overriddenById   String?

  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  zone             Zone     @relation(fields: [zoneId], references: [id])
  applicator       User     @relation("SprayApplicator", fields: [applicatorId], references: [id])
  overriddenBy     User?    @relation("SprayOverrider", fields: [overriddenById], references: [id])

  @@index([tenantId])
  @@index([zoneId])
  @@index([appliedAt])
  @@map("spray_logs")
}
