generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  status                TenantStatus           @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  settings              Json?                  @default("{}")
  unitPreference        UnitSystem             @default(METRIC)
  baseCurrency          String                 @default("USD")
  accounts              Account[]
  alerts                Alert[]
  auditLogs             AuditLog[]
  automationRules       AutomationRule[]
  budgets               Budget[]
  certifications        Certification[]
  coldRoomEvents        ColdRoomEvent[]
  communications        Communication[]
  contactLogs           ContactLog[]
  costCentres           CostCentre[]
  cropBudgets           CropBudget[]
  cropCycles            CropCycle[]
  cropPerformanceLogs   CropPerformanceLog[]
  cropSchedules         CropSchedule[]
  customers             Customer[]
  deliveryRoutes        DeliveryRoute[]
  deliveryStops         DeliveryStop[]
  employeeKpis          EmployeeKPI[]
  employees             Employee[]
  exchangeRates         ExchangeRate[]
  exportDocuments       ExportDocument[]
  farmProfile           FarmProfile?
  financialJournals     FinancialJournal[]
  flowerBatches         FlowerBatch[]
  flowerInventory       FlowerInventory[]
  goodsReceivedNotes    GoodsReceivedNote[]
  harvestRecords        HarvestRecord[]
  invoices              Invoice[]
  iotDevices            IoTDevice[]
  irrigationLogs        IrrigationLog[]
  labourLogs            LabourLog[]
  landPrepLogs          LandPrepLog[]
  leads                 Lead[]
  leaveRequests         LeaveRequest[]
  notifications         Notification[]
  orders                Order[]
  packedBoxes           PackedBox[]
  payroll               PayrollRecord[]
  payrollRuns           PayrollRun[]
  payslips              Payslip[]
  appraisals            PerformanceAppraisal[]
  plantingRecords       PlantingRecord[]
  preHarvestQualityLogs PreHarvestQualityLog[]
  products              Product[]
  purchaseOrders        PurchaseOrder[]
  purchaseRequests      PurchaseRequest[]
  qcLogs                QCLog[]
  rfqResponses          RfqResponse[]
  rfqs                  Rfq[]
  roles                 Role[]
  scoutingReports       ScoutingReport[]
  shiftAssignments      ShiftAssignment[]
  shifts                Shift[]
  soilTests             SoilTest[]
  sprayLogs             SprayLog[]
  storeItems            StoreItem[]
  storeMovements        StoreMovement[]
  storeStock            StoreStock[]
  taxRates              TaxRate[]
  telemetry             TelemetryReading[]
  trainingCourses       TrainingCourse[]
  trainingRecords       TrainingRecord[]
  trainingSchedules     TrainingSchedule[]
  users                 User[]
  varieties             Variety[]
  vehicles              Vehicle[]
  vendors               Vendor[]
  wastageLogs           WastageLog[]
  zones                 Zone[]
  auctionLots           AuctionLot[]
  vendorInvoices        VendorInvoice[]
  vendorPerformanceLogs VendorPerformanceLog[]
  aiTokenBudget         Int                    @default(1000000)
  aiTokensUsed          Int                    @default(0)
  chatSessions          ChatSession[]

  @@map("tenants")
}

model ChatSession {
  id        String        @id @default(uuid())
  tenantId  String
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]

  @@index([tenantId])
  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String      @id @default(uuid())
  sessionId   String
  role        String
  content     String
  attachments Json?
  tokensUsed  Int         @default(0)
  createdAt   DateTime    @default(now())
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  users       User[]

  @@unique([name, tenantId])
  @@map("roles")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  tenantId              String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  roleId                String
  firstName             String?
  lastName              String?
  phone                 String?
  isActive              Boolean                @default(true)
  mustChangePassword    Boolean                @default(false)
  lastLoginAt           DateTime?
  actorAuditLogs        AuditLog[]             @relation("ActorLogs")
  coldRoomEvents        ColdRoomEvent[]
  contactLogs           ContactLog[]
  cropPerformanceLogs   CropPerformanceLog[]
  deliveryRoutes        DeliveryRoute[]
  harvestRecords        HarvestRecord[]
  irrigationLogs        IrrigationLog[]
  labourLogs            LabourLog[]
  landPrepLogs          LandPrepLog[]
  leads                 Lead[]
  notifications         Notification[]         @relation("UserNotifications")
  payrollRecords        PayrollRecord[]
  preHarvestQualityLogs PreHarvestQualityLog[]
  scoutingReports       ScoutingReport[]       @relation("ScoutingInspector")
  sprayLogs             SprayLog[]             @relation("SprayApplicator")
  overridenSprays       SprayLog[]             @relation("SprayOverrider")
  chatSessions          ChatSession[]
  role                  Role                   @relation(fields: [roleId], references: [id])
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])

  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  beforeState Json?
  afterState  Json?
  timestamp   DateTime @default(now())
  actor       User?    @relation("ActorLogs", fields: [actorId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([timestamp])
  @@map("audit_logs")
}

model Communication {
  id         String   @id @default(uuid())
  threadId   String?
  entityType String?
  entityId   String?
  direction  String
  channel    String
  subject    String?
  body       String
  tenantId   String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([threadId])
  @@map("communications")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation("UserNotifications", fields: [userId], references: [id])

  @@index([userId])
  @@index([tenantId])
  @@map("notifications")
}

model FarmProfile {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  name            String
  location        String?
  gpsCoordinates  String?
  certifications  String[]
  contactEmail    String?
  contactPhone    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  logoUrl         String?
  defaultCurrency String   @default("KES")
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@map("farm_profiles")
}

model Zone {
  id              String           @id @default(uuid())
  tenantId        String
  name            String
  areaSqm         Float?
  cropVarieties   String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isArchived      Boolean          @default(false)
  layout          Json?
  lastWatered     DateTime?
  plantCount      Float?
  maxHumidity     Float?           @default(100)
  maxTemp         Float?           @default(40)
  minHumidity     Float?           @default(0)
  minTemp         Float?           @default(0)
  type            ZoneType         @default(GREENHOUSE)
  coldEvents      ColdRoomEvent[]
  cropCycles      CropCycle[]
  devices         IoTDevice[]
  irrigationLogs  IrrigationLog[]
  labourLogs      LabourLog[]
  landPrepLogs    LandPrepLog[]
  scoutingReports ScoutingReport[]
  soilTests       SoilTest[]
  sprayLogs       SprayLog[]
  storeMovements  StoreMovement[]
  storeStock      StoreStock[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id])

  @@map("zones")
}

model IoTDevice {
  id         String             @id @default(uuid())
  tenantId   String
  zoneId     String?
  type       String
  macAddress String             @unique
  mqttTopic  String
  status     String             @default("ACTIVE")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  zone       Zone?              @relation(fields: [zoneId], references: [id])
  readings   TelemetryReading[]

  @@map("iot_devices")
}

model Customer {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  email          String?
  address        String?
  country        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  commissionRate Float?
  contactPerson  String?
  creditLimit    Float?
  notes          String?
  paymentTerms   String?
  phone          String?
  segment        CustomerSegment @default(LOCAL_RETAIL)
  type           CustomerType    @default(DIRECT_BUYER)
  contactLogs    ContactLog[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  leads          Lead[]
  orders         Order[]

  @@map("customers")
}

model ContactLog {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  userId     String
  type       String
  subject    String?
  notes      String
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@map("contact_logs")
}

model Lead {
  id           String     @id @default(uuid())
  tenantId     String
  customerId   String?
  name         String
  email        String?
  phone        String?
  status       LeadStatus @default(PROSPECT)
  value        Float?
  assignedToId String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedTo   User?      @relation(fields: [assignedToId], references: [id])
  customer     Customer?  @relation(fields: [customerId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("leads")
}

model Order {
  id                 String             @id @default(uuid())
  tenantId           String
  type               OrderType          @default(SPOT_ORDER)
  status             OrderStatus        @default(DRAFT)
  customerId         String
  items              Json
  totalAmount        Float
  currency           String             @default("USD")
  shipmentDate       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deliveryDate       DateTime?
  isTemplate         Boolean            @default(false)
  nextGenerationDate DateTime?
  notes              String?
  orderNumber        String?
  parentTemplateId   String?
  templateFrequency  TemplateFrequency?
  deliveryStop       DeliveryStop?
  exportDocuments    ExportDocument[]
  invoice            Invoice?
  customer           Customer           @relation(fields: [customerId], references: [id])
  template           Order?             @relation("OrderTemplates", fields: [parentTemplateId], references: [id])
  generatedOrders    Order[]            @relation("OrderTemplates")
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  packedBoxes        PackedBox[]
  auctionLots        AuctionLot[]

  @@index([tenantId])
  @@index([status])
  @@index([isTemplate])
  @@map("orders")
}

model AuctionLot {
  id            String           @id @default(uuid())
  tenantId      String
  clockNumber   String
  varietyId     String
  grade         QCGrade
  bunchSize     Int
  totalBunches  Int
  totalStems    Int
  expectedPrice Float?
  actualPrice   Float?
  status        AuctionLotStatus @default(PREPARED)
  auctionDate   DateTime?
  orderId       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  order   Order?  @relation(fields: [orderId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  variety Variety @relation(fields: [varietyId], references: [id])

  @@index([tenantId])
  @@map("auction_lots")
}

model TelemetryReading {
  id         String    @default(uuid())
  tenantId   String
  deviceId   String
  value      Float
  unit       String?
  timestamp  DateTime  @default(now())
  sensorType String    @default("MOISTURE")
  device     IoTDevice @relation(fields: [deviceId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@id([id, timestamp])
  @@index([tenantId])
  @@index([deviceId])
  @@index([timestamp])
  @@map("telemetry_readings")
}

model Alert {
  id        String   @id @default(uuid())
  tenantId  String
  deviceId  String?
  zoneId    String?
  type      String   @default("THRESHOLD_BREACH")
  severity  String   @default("MEDIUM")
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("alerts")
}

model AutomationRule {
  id         String   @id @default(uuid())
  tenantId   String
  zoneId     String?
  name       String
  sensorType String
  operator   String   @default("LT")
  threshold  Float
  action     String   @default("NOTIFY")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("automation_rules")
}

model LabourLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  zoneId      String
  taskType    String
  hours       Float
  stemsCut    Int?
  timestamp   DateTime @default(now())
  gpsLocation Json?
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  zone        Zone     @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
  @@map("labour_logs")
}

model PayrollRecord {
  id          String        @id @default(uuid())
  tenantId    String
  userId      String
  amount      Float
  currency    String        @default("KES")
  status      PayrollStatus @default(PENDING)
  period      String
  paymentDate DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  type        PayrollType   @default(FIXED)
  hoursWorked Float?
  hourlyRate  Float?
  baseAmount  Float?
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("payroll_records")
}

model Product {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  sku       String   @unique
  stock     Int      @default(0)
  unitPrice Float
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("products")
}

model Variety {
  id                    String            @id @default(uuid())
  tenantId              String
  name                  String
  targetStemLength      Float?
  targetStemCountPerSqm Float?
  bloomTime             Int?
  marketGrade           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  defaultCostPerStem    Float?
  cropCycles            CropCycle[]
  flowerInventory       FlowerInventory[]
  packedBoxes           PackedBox[]
  tenant                Tenant            @relation(fields: [tenantId], references: [id])
  wastageLogs           WastageLog[]
  auctionLots           AuctionLot[]
  flowerBatches         FlowerBatch[]

  @@map("varieties")
}

model CropCycle {
  id                    String                 @id @default(uuid())
  tenantId              String
  varietyId             String
  zoneId                String?
  startDate             DateTime
  projectedHarvestDate  DateTime?
  actualHarvestDate     DateTime?
  actualHarvestYield    Int?
  status                CropCycleStatus        @default(PLANNED)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  cropBudget            CropBudget?
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  variety               Variety                @relation(fields: [varietyId], references: [id])
  zone                  Zone?                  @relation(fields: [zoneId], references: [id])
  cropPerformanceLogs   CropPerformanceLog[]
  schedules             CropSchedule[]
  flowerBatches         FlowerBatch[]
  harvestRecords        HarvestRecord[]
  plantingRecord        PlantingRecord?
  preHarvestQualityLogs PreHarvestQualityLog[]
  scoutingReports       ScoutingReport[]

  @@map("crop_cycles")
}

model CropSchedule {
  id            String       @id @default(uuid())
  tenantId      String
  cropCycleId   String
  type          ScheduleType
  taskName      String
  scheduledDate DateTime
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  cropCycle     CropCycle    @relation(fields: [cropCycleId], references: [id])
  tenant        Tenant       @relation(fields: [tenantId], references: [id])

  @@map("crop_schedules")
}

model SprayLog {
  id               String   @id @default(uuid())
  tenantId         String
  zoneId           String
  chemicalName     String
  epaRegNo         String
  quantity         Float
  unit             String
  phiDays          Int      @default(0)
  applicatorId     String
  appliedAt        DateTime @default(now())
  harvestAllowedAt DateTime
  notes            String?
  overrideReason   String?
  overriddenById   String?
  applicator       User     @relation("SprayApplicator", fields: [applicatorId], references: [id])
  overriddenBy     User?    @relation("SprayOverrider", fields: [overriddenById], references: [id])
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  zone             Zone     @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@index([zoneId])
  @@index([appliedAt])
  @@map("spray_logs")
}

model FlowerBatch {
  id             String          @id @default(uuid())
  tenantId       String
  cropCycleId    String
  varietyId      String
  batchNumber    String          @unique
  quantityIntake Int
  status         BatchStatus     @default(QC_PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  coldRoomEvents ColdRoomEvent[]
  cropCycle      CropCycle       @relation(fields: [cropCycleId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  variety        Variety         @relation(fields: [varietyId], references: [id])
  packedBoxes    PackedBox[]
  qcLogs         QCLog[]

  @@index([tenantId])
  @@index([batchNumber])
  @@map("flower_batches")
}

model QCLog {
  id            String      @id @default(uuid())
  tenantId      String
  batchId       String
  inspectorId   String?
  stemLength    Float
  bloomStage    String
  headDiameter  Float
  defects       Json
  assignedGrade QCGrade
  notes         String?
  createdAt     DateTime    @default(now())
  batch         FlowerBatch @relation(fields: [batchId], references: [id])
  tenant        Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([batchId])
  @@map("qc_logs")
}

model FlowerInventory {
  id        String   @id @default(uuid())
  tenantId  String
  varietyId String
  grade     QCGrade
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  variety   Variety  @relation(fields: [varietyId], references: [id])

  @@unique([tenantId, varietyId, grade])
  @@index([tenantId])
  @@map("flower_inventory")
}

model ColdRoomEvent {
  id        String            @id @default(uuid())
  tenantId  String
  zoneId    String
  batchId   String
  type      ColdRoomEventType
  quantity  Int
  userId    String
  timestamp DateTime          @default(now())
  batch     FlowerBatch       @relation(fields: [batchId], references: [id])
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
  zone      Zone              @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@index([batchId])
  @@index([zoneId])
  @@map("cold_room_events")
}

model PackedBox {
  id            String       @id @default(uuid())
  tenantId      String
  batchId       String?
  varietyId     String
  status        BoxStatus    @default(PACKED)
  grade         QCGrade
  bunchSize     Int
  packDate      DateTime     @default(now())
  destination   String?
  labelUrl      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  boxId         String       @unique
  bunchesPerBox Int
  orderId       String?
  totalStems    Int
  batch         FlowerBatch? @relation(fields: [batchId], references: [id])
  order         Order?       @relation(fields: [orderId], references: [id])
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  variety       Variety      @relation(fields: [varietyId], references: [id])

  @@index([tenantId])
  @@index([boxId])
  @@map("packed_boxes")
}

model WastageLog {
  id           String        @id @default(uuid())
  tenantId     String
  varietyId    String
  grade        QCGrade
  quantity     Int
  reason       WastageReason
  costPerStem  Float?
  costImpact   Float?
  notes        String?
  recordedById String?
  createdAt    DateTime      @default(now())
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  variety      Variety       @relation(fields: [varietyId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
  @@map("wastage_logs")
}

model StoreItem {
  id                 String              @id @default(uuid())
  tenantId           String
  name               String
  sku                String
  category           StoreItemCategory   @default(OTHER)
  unit               String              @default("units")
  description        String?
  minStockLevel      Float               @default(0)
  reorderPoint       Float               @default(0)
  unitCost           Float               @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastUnitPrice      Float?
  maxStockLevel      Float               @default(0)
  preferredVendorId  String?
  grnItems           GrnItem[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseRequests   PurchaseRequest[]
  preferredVendor    Vendor?             @relation(fields: [preferredVendorId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  movements          StoreMovement[]
  stock              StoreStock[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("store_items")
}

model StoreStock {
  id        String    @id @default(uuid())
  tenantId  String
  itemId    String
  zoneId    String
  quantity  Float     @default(0)
  updatedAt DateTime  @updatedAt
  item      StoreItem @relation(fields: [itemId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  zone      Zone      @relation(fields: [zoneId], references: [id])

  @@unique([tenantId, itemId, zoneId])
  @@index([tenantId])
  @@map("store_stock")
}

model StoreMovement {
  id          String            @id @default(uuid())
  tenantId    String
  itemId      String
  zoneId      String
  type        StoreMovementType
  quantity    Float
  reference   String?
  toZoneId    String?
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())
  item        StoreItem         @relation(fields: [itemId], references: [id])
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  zone        Zone              @relation(fields: [zoneId], references: [id])

  @@index([tenantId])
  @@index([itemId])
  @@index([createdAt])
  @@map("store_movements")
}

model Vendor {
